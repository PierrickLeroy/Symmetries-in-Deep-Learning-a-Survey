@misc{maass2024,
  title = {Symmetries in {{Overparametrized Neural Networks}}: {{A Mean-Field View}}},
  shorttitle = {Symmetries in {{Overparametrized Neural Networks}}},
  author = {Maass, Javier and Fontbona, Joaquin},

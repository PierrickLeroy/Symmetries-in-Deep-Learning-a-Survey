  publisher = {arXiv},
  urldate = {2024-05-08},
  abstract = {Group Convolutional Neural Networks (G-CNNs) constrain learned features to respect the symmetries in the selected group, and lead to better generalization when these symmetries appear in the data. If this is not the case, however, equivariance leads to overly constrained models and worse performance. Frequently, transformations occurring in data can be better represented by a subset of a group than by a group as a whole, e.g., rotations in \$[-90\textasciicircum\textbraceleft\textbackslash circ\textbraceright, 90\textasciicircum\textbraceleft\textbackslash circ\textbraceright ]\$. In such cases, a model that respects equivariance \$\textbackslash textit\textbraceleft partially\textbraceright\$ is better suited to represent the data. In addition, relevant transformations may differ for low and high-level features. For instance, full rotation equivariance is useful to describe edge orientations in a face, but partial rotation equivariance is better suited to describe face poses relative to the camera. In other words, the optimal level of equivariance may differ per layer. In this work, we introduce \$\textbackslash textit\textbraceleft Partial G-CNNs\textbraceright\$: G-CNNs able to learn layer-wise levels of partial and full equivariance to discrete, continuous groups and combinations thereof as part of training. Partial G-CNNs retain full equivariance when beneficial, e.g., for rotated MNIST, but adjust it whenever it becomes harmful, e.g., for classification of 6 / 9 digits or natural images. We empirically show that partial G-CNNs pair G-CNNs when full equivariance is advantageous, and outperform them otherwise.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {/read,approximate symmetry,equivariance/relaxed equivariance,sym-survey/partial equivariance,symmetry discovery},
  file = {/home/pierrick/GoogleDrive/zotero-library/2023/Romero/romero2023.pdf}
}

@article{romero2023tmlr,
  title = {Wavelet {{Networks}}: {{Scale-Translation Equivariant Learning From Raw Time-Series}}},

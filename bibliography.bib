  shorttitle = {Stochastic Gradient Descent without Full Data Shuffle},
  author = {Xu, Lijie and Qiu, Shuang and Yuan, Binhang and Jiang, Jiawei and Renggli, Cedric and Gan, Shaoduo and Kara, Kaan and Li, Guoliang and Liu, Ji and Wu, Wentao and Ye, Jieping and Zhang, Ce},

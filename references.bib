@online{heiter2023,
  title = {Topologically {{Regularized Data Embeddings}}},
  author = {Heiter, Edith and Vandaele, Robin and Bie, Tijl De and Saeys, Yvan and Lijffijt, Jefrey},
  date = {2023-11-07},
  eprint = {2301.03338},

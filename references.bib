  keywords = {/unread,pruning/sparsify during training},
  file = {/home/pierrick/OneDrive/zotero-library/2016/Jin/Jin et al. - 2016 - Training Skinny Deep Neural Networks with Iterative Hard Thresholding Methods.pdf}
}


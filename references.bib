@article{mei2018pnas,
  title = {A Mean Field View of the Landscape of Two-Layer Neural Networks},
  author = {Mei, Song and Montanari, Andrea and Nguyen, Phan-Minh},
  date = {2018-08-14},
  journaltitle = {Proceedings of the National Academy of Sciences},
  volume = {115},

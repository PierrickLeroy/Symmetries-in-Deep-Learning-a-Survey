	url = {https://www.youtube.com/watch?v=u7a9YZ9kDcQ},
	abstract = {(27 septembre 2021 / September 27, 2021) Seminar Applied Mathematics / Mathématiques appliquées https://dms.umontreal.ca/{\textasciitilde}mathapp/abs...

Gitta Kutyniok (LMU Munich, Gernmany) https://scholar.google.de/citations?u...

@article{hochreiter1997nc,
  title = {Flat {{Minima}}},
  author = {Hochreiter, Sepp and Schmidhuber, Jürgen},
  date = {1997-01-01},
  journaltitle = {Neural Computation},
  shortjournal = {Neural Comput},
  volume = {9},

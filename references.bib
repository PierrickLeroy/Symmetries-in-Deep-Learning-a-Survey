@misc{uscidda2024,
	title = {Disentangled {Representation} {Learning} with the {Gromov}-{Monge} {Gap}},
	url = {http://arxiv.org/abs/2407.07829},
	doi = {10.48550/arXiv.2407.07829},
	abstract = {Learning disentangled representations from unlabelled data is a fundamental challenge in machine learning. Solving it may unlock other problems, such as generalization, interpretability, or fairness. Although remarkably challenging to solve in theory, disentanglement is often achieved in practice through prior matching. Furthermore, recent works have shown that prior matching approaches can be enhanced by leveraging geometrical considerations, e.g., by learning representations that preserve geometric features of the data, such as distances or angles between points. However, matching the prior while preserving geometric features is challenging, as a mapping that fully preserves these features while aligning the data distribution with the prior does not exist in general. To address these challenges, we introduce a novel approach to disentangled representation learning based on quadratic optimal transport. We formulate the problem using Gromov-Monge maps that transport one distribution onto another with minimal distortion of predefined geometric features, preserving them as much as can be achieved. To compute such maps, we propose the Gromov-Monge-Gap (GMG), a regularizer quantifying whether a map moves a reference distribution with minimal geometry distortion. We demonstrate the effectiveness of our approach for disentanglement across four standard benchmarks, outperforming other methods leveraging geometric considerations.},
	urldate = {2024-12-15},
	publisher = {arXiv},
	author = {Uscidda, Théo and Eyring, Luca and Roth, Karsten and Theis, Fabian and Akata, Zeynep and Cuturi, Marco},
	month = oct,
	year = {2024},
	note = {arXiv:2407.07829 [cs]},
	keywords = {/unread, neurips 2024, optimal transport},
}

@misc{piran2024,
	title = {Contrasting {Multiple} {Representations} with the {Multi}-{Marginal} {Matching} {Gap}},
	url = {http://arxiv.org/abs/2405.19532},
	doi = {10.48550/arXiv.2405.19532},
	abstract = {Learning meaningful representations of complex objects that can be seen through multiple (\$k{\textbackslash}geq 3\$) views or modalities is a core task in machine learning. Existing methods use losses originally intended for paired views, and extend them to \$k\$ views, either by instantiating \${\textbackslash}tfrac12k(k-1)\$ loss-pairs, or by using reduced embeddings, following a {\textbackslash}textit\{one vs. average-of-rest\} strategy. We propose the multi-marginal matching gap (M3G), a loss that borrows tools from multi-marginal optimal transport (MM-OT) theory to simultaneously incorporate all \$k\$ views. Given a batch of \$n\$ points, each seen as a \$k\$-tuple of views subsequently transformed into \$k\$ embeddings, our loss contrasts the cost of matching these \$n\$ ground-truth \$k\$-tuples with the MM-OT polymatching cost, which seeks \$n\$ optimally arranged \$k\$-tuples chosen within these \$n{\textbackslash}times k\$ vectors. While the exponential complexity \$O(n{\textasciicircum}k\$) of the MM-OT problem may seem daunting, we show in experiments that a suitable generalization of the Sinkhorn algorithm for that problem can scale to, e.g., \$k=3{\textbackslash}sim 6\$ views using mini-batches of size \$64{\textasciitilde}{\textbackslash}sim128\$. Our experiments demonstrate improved performance over multiview extensions of pairwise losses, for both self-supervised and multimodal tasks.},
	urldate = {2024-12-15},
	publisher = {arXiv},
	author = {Piran, Zoe and Klein, Michal and Thornton, James and Cuturi, Marco},
	month = may,
	year = {2024},
	note = {arXiv:2405.19532 [cs]},
	keywords = {/unread, contrastive learning, neurips 2024, optimal transport},
}


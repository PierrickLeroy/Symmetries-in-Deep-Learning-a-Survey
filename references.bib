@inproceedings{michaelhauser2017anips,
  title = {Principles of {{Riemannian Geometry}} in {{Neural Networks}}},
  booktitle = {Advances in {{Neural Information Processing Systems}}},
  author = {{Michael Hauser} and Ray, Asok},
  date = {2017},
  volume = {30},

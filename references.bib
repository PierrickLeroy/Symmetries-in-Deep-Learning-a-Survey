@misc{martinelli2025a,
	title = {Flat {Channels} to {Infinity} in {Neural} {Loss} {Landscapes}},
	url = {https://arxiv.org/abs/2506.14951v1},
	abstract = {The loss landscapes of neural networks contain minima and saddle points that may be connected in flat regions or appear in isolation. We identify and characterize a special structure in the loss landscape: channels along which the loss decreases extremely slowly, while the output weights of at least two neurons, \$a\_i\$ and \$a\_j\$, diverge to \${\textbackslash}pm\$infinity, and their input weight vectors, \${\textbackslash}mathbf\{w\_i\}\$ and \${\textbackslash}mathbf\{w\_j\}\$, become equal to each other. At convergence, the two neurons implement a gated linear unit: \$a\_i{\textbackslash}sigma({\textbackslash}mathbf\{w\_i\} {\textbackslash}cdot {\textbackslash}mathbf\{x\}) + a\_j{\textbackslash}sigma({\textbackslash}mathbf\{w\_j\} {\textbackslash}cdot {\textbackslash}mathbf\{x\}) {\textbackslash}rightarrow {\textbackslash}sigma({\textbackslash}mathbf\{w\} {\textbackslash}cdot {\textbackslash}mathbf\{x\}) + ({\textbackslash}mathbf\{v\} {\textbackslash}cdot {\textbackslash}mathbf\{x\}) {\textbackslash}sigma'({\textbackslash}mathbf\{w\} {\textbackslash}cdot {\textbackslash}mathbf\{x\})\$. Geometrically, these channels to infinity are asymptotically parallel to symmetry-induced lines of critical points. Gradient flow solvers, and related optimization methods like SGD or ADAM, reach the channels with high probability in diverse regression settings, but without careful inspection they look like flat local minima with finite parameter values. Our characterization provides a comprehensive picture of these quasi-flat regions in terms of gradient dynamics, geometry, and functional interpretation. The emergence of gated linear units at the end of the channels highlights a surprising aspect of the computational capabilities of fully connected layers.},
	language = {en},
	urldate = {2025-10-12},
	journal = {arXiv.org},
	author = {Martinelli, Flavio and Van Meegen, Alexander and Şimşek, Berfin and Gerstner, Wulfram and Brea, Johanni},
	month = jun,
	year = {2025},
	keywords = {/unread},
}

@article{gupta2020ca,

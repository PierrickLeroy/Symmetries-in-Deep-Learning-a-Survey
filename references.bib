@article{cornet2024,
  title = {Equivariant {{Neural Diffusion}} for {{Molecule Generation}}},
  author = {Cornet, François and Bartosh, Grigory and Schmidt, Mikkel N and Naesseth, Christian A},
  date = {2024},
  abstract = {We introduce Equivariant Neural Diffusion (END), a novel diffusion model for molecule generation in 3D that is equivariant to Euclidean transformations. Compared to current state-ofthe-art equivariant diffusion models, the key innovation in END lies in its learnable forward process for enhanced generative modelling. Rather than pre-specified, the forward process is parameterized through a time- and data-dependent transformation that is equivariant to rigid transformations. Through a series of experiments on standard molecule generation benchmarks, we demonstrate that END improves on several strong baselines for both unconditional and conditional generation.},

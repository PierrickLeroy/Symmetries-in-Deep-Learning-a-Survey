}

@online{jacot2022a,
  title = {Feature {{Learning}} in \${{L}}\_\{2\}\$-Regularized {{DNNs}}: {{Attraction}}/{{Repulsion}} and {{Sparsity}}},
  shorttitle = {Feature {{Learning}} in \${{L}}\_\{2\}\$-Regularized {{DNNs}}},
  author = {Jacot, Arthur and Golikov, Eugene and Hongler, Clément and Gabriel, Franck},
  date = {2022-10-13},
  eprint = {2205.15809},
  eprinttype = {arXiv},
  eprintclass = {stat},
  doi = {10.48550/arXiv.2205.15809},
  url = {http://arxiv.org/abs/2205.15809},
  urldate = {2026-01-23},
  abstract = {We study the loss surface of DNNs with \$L\_\{2\}\$ regularization. We show that the loss in terms of the parameters can be reformulated into a loss in terms of the layerwise activations \$Z\_\{\textbackslash ell\}\$ of the training set. This reformulation reveals the dynamics behind feature learning: each hidden representations \$Z\_\{\textbackslash ell\}\$ are optimal w.r.t. to an attraction/repulsion problem and interpolate between the input and output representations, keeping as little information from the input as necessary to construct the activation of the next layer. For positively homogeneous non-linearities, the loss can be further reformulated in terms of the covariances of the hidden representations, which takes the form of a partially convex optimization over a convex cone. This second reformulation allows us to prove a sparsity result for homogeneous DNNs: any local minimum of the \$L\_\{2\}\$-regularized loss can be achieved with at most \$N(N+1)\$ neurons in each hidden layer (where \$N\$ is the size of the training set). We show that this bound is tight by giving an example of a local minimum that requires \$N\textasciicircum\{2\}/4\$ hidden neurons. But we also observe numerically that in more traditional settings much less than \$N\textasciicircum\{2\}\$ neurons are required to reach the minima.},
  pubstate = {prepublished},
  keywords = {/read,loss,representation,sparsity},
  annotation = {TLDR: A sparsity result for homogeneous DNNs is proved: any local minimum of the \$L\_\{2\}\$-regularized loss can be achieved with at most \$N(N+1)\$ neurons in each hidden layer (where \$N\$ is the size of the training set).},
  file = {/home/pierrick/OneDrive/zotero-library/2022/Jacot/Jacot et al. - 2022 - Feature Learning in $L_ 2 $-regularized DNNs AttractionRepulsion and Sparsity.pdf}
}


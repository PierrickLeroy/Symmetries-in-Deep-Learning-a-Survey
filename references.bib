@article{zhang2023bspac,
  title = {Multi-{{Source}} Geometric Metric Transfer Learning for {{EEG}} Classification},
  author = {Zhang, Xianxiong and She, Qingshan and Tan, Tongcai and Gao, Yunyuan and Ma, Yuliang and Zhang, Jianhai},
  date = {2023-03-01},
  journaltitle = {Biomedical Signal Processing and Control},
  shortjournal = {Biomedical Signal Processing and Control},
  volume = {81},

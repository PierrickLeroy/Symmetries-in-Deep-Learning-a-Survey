@misc{petarvelickovicGeometricDeepLearning2021,
	title = {Geometric {Deep} {Learning}: {GNNs} {Beyond} {Permutation} {Equivariance}},
	shorttitle = {Geometric {Deep} {Learning}},
	url = {https://www.youtube.com/watch?v=aCUOAkOqNoU},

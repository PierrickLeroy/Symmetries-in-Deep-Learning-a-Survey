@online{nurisso2024,
  title = {Higher-Order {{Laplacian Renormalization}}},
  author = {Nurisso, Marco and Morandini, Marta and Lucas, Maxime and Vaccarino, Francesco and Gili, Tommaso and Petri, Giovanni},
  date = {2024-02-06},

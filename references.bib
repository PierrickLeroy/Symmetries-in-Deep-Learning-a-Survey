  keywords = {/read,watermarking},
  file = {/home/pierrick/OneDrive/zotero-library/2021/Boenisch/Boenisch - 2021 - A Systematic Review on Model Watermarking for Neural Networks.pdf}
}

@inproceedings{bogatskiy2020p3icml,
  title = {Lorentz {{Group Equivariant Neural Network}} for {{Particle Physics}}},

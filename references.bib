@article{dubut2017acs,
	title = {Directed {Homology} {Theories} and {Eilenberg}-{Steenrod} {Axioms}},
	volume = {25},
	issn = {1572-9095},
	url = {https://doi.org/10.1007/s10485-016-9438-y},
	doi = {10.1007/s10485-016-9438-y},
	abstract = {In this paper, we define and study a homology theory, that we call “natural homology”, which associates a natural system of abelian groups to every space in a large class of directed spaces and precubical sets. We show that this homology theory enjoys many important properties, as an invariant for directed homotopy. Among its properties, we show that subdivided precubical sets have the same homology type as the original ones ; similarly, the natural homology of a precubical set is of the same type as the natural homology of its geometric realization. By same type we mean equivalent up to some form of bisimulation, that we define using the notion of open map. Last but not least, natural homology, for the class of spaces we consider, exhibits very important properties such as Hurewicz theorems, and most of Eilenberg-Steenrod axioms, in particular the dimension, homotopy, additivity and exactness axioms. This last axiom is studied in a general framework of (generalized) exact sequences.},
	language = {en},
	number = {5},
	urldate = {2024-02-07},
	journal = {Applied Categorical Structures},
	author = {Dubut, Jérémy and Goubault, Eric and Goubault-Larrecq, Jean},
	month = oct,
	year = {2017},
	keywords = {/unread, directed homology, path homology},
	pages = {775--807},
}


@article{robins2011itpami,
  title = {Theory and {{Algorithms}} for {{Constructing Discrete Morse Complexes}} from {{Grayscale Digital Images}}},
  author = {Robins, V and Wood, P J and Sheppard, A P},
  date = {2011-08},
  journaltitle = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  shortjournal = {IEEE Trans. Pattern Anal. Mach. Intell.},
  volume = {33},
  number = {8},
  pages = {1646--1658},
  issn = {0162-8828},
  doi = {10.1109/TPAMI.2011.95},
  url = {http://ieeexplore.ieee.org/document/5766002/},
  urldate = {2024-09-19},
  abstract = {We present an algorithm for determining the Morse complex of a 2- or 3-dimensional grayscale digital image. Each cell in the Morse complex corresponds to a topological change in the level sets (i.e. a critical point) of the grayscale image. Since more than one critical point may be associated with a single image voxel, we model digital images by cubical complexes. A new homotopic algorithm is used to construct a discrete Morse function on the cubical complex that agrees with the digital image and has exactly the number and type of critical cells necessary to characterize the topological changes in the level sets. We make use of discrete Morse theory and simple homotopy theory to prove correctness of this algorithm. The resulting Morse complex is considerably simpler than the cubical complex originally used to represent the image and may be used to compute persistent homology.},
  langid = {english},
  keywords = {/unread,Morse theory/discrete Morse theory},
  file = {/home/pierrick/OneDrive/zotero-library/2011/Robins/Robins et al. - 2011 - Theory and Algorithms for Constructing Discrete Morse Complexes from Grayscale Digital Images.pdf}
}

@inproceedings{rolnick2020p3icml,
  title = {Reverse-Engineering Deep {{ReLU}} Networks},
  booktitle = {Proceedings of the 37th {{International Conference}} on {{Machine Learning}}},
  author = {Rolnick, David and Kording, Konrad},
  date = {2020-11-21},
  pages = {8178--8187},
  publisher = {PMLR},
  issn = {2640-3498},
  url = {https://proceedings.mlr.press/v119/rolnick20a.html},
  urldate = {2025-11-10},
  abstract = {The output of a neural network depends on its architecture and weights in a highly nonlinear way, and it is often assumed that a network’s parameters cannot be recovered from its output. Here, we prove that, in fact, it is frequently possible to reconstruct the architecture, weights, and biases of a deep ReLU network by observing only its output. We leverage the fact that every ReLU network defines a piecewise linear function, where the boundaries between linear regions correspond to inputs for which some neuron in the network switches between inactive and active ReLU states. By dissecting the set of region boundaries into components associated with particular neurons, we show both theoretically and empirically that it is possible to recover the weights of neurons and their arrangement within the network, up to isomorphism.},
  eventtitle = {International {{Conference}} on {{Machine Learning}}},
  langid = {english},
  keywords = {/read,reconstruction,ReLU network,symmetry},
  annotation = {GSCC: 0000155 2026-02-21T16:12:50.746Z 0.56},
  file = {/home/pierrick/OneDrive/zotero-library/2020/Rolnick/Rolnick and Kording - 2020 - Reverse-engineering deep ReLU networks.pdf}
}

@online{romero2023,
  title = {Learning {{Partial Equivariances}} from {{Data}}},
  author = {Romero, David W. and Lohit, Suhas},
  date = {2023-01-14},
  eprint = {2110.10211},
  eprinttype = {arXiv},
  eprintclass = {cs},
  url = {http://arxiv.org/abs/2110.10211},
  urldate = {2024-05-08},
  abstract = {Group Convolutional Neural Networks (G-CNNs) constrain learned features to respect the symmetries in the selected group, and lead to better generalization when these symmetries appear in the data. If this is not the case, however, equivariance leads to overly constrained models and worse performance. Frequently, transformations occurring in data can be better represented by a subset of a group than by a group as a whole, e.g., rotations in \$[-90\textasciicircum\{\textbackslash circ\}, 90\textasciicircum\{\textbackslash circ\}]\$. In such cases, a model that respects equivariance \$\textbackslash textit\{partially\}\$ is better suited to represent the data. In addition, relevant transformations may differ for low and high-level features. For instance, full rotation equivariance is useful to describe edge orientations in a face, but partial rotation equivariance is better suited to describe face poses relative to the camera. In other words, the optimal level of equivariance may differ per layer. In this work, we introduce \$\textbackslash textit\{Partial G-CNNs\}\$: G-CNNs able to learn layer-wise levels of partial and full equivariance to discrete, continuous groups and combinations thereof as part of training. Partial G-CNNs retain full equivariance when beneficial, e.g., for rotated MNIST, but adjust it whenever it becomes harmful, e.g., for classification of 6 / 9 digits or natural images. We empirically show that partial G-CNNs pair G-CNNs when full equivariance is advantageous, and outperform them otherwise.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {/unread,approximate symmetry,equivariance/relaxed equivariance,symmetry discovery},
  file = {/home/pierrick/OneDrive/zotero-library/2023/Romero/Romero and Lohit - 2023 - Learning Partial Equivariances from Data.pdf}
}


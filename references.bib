@online{lin2021,
  title = {{{xCos}}: {{An Explainable Cosine Metric}} for {{Face Verification Task}}},
  shorttitle = {{{xCos}}},
  author = {Lin, Yu-Sheng and Liu, Zhe-Yu and Chen, Yu-An and Wang, Yu-Siang and Chang, Ya-Liang and Hsu, Winston H.},

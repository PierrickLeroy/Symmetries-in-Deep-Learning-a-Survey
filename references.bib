	keywords = {/read, energy based model, smoothness, snake},
	pages = {321--331},
}

@incollection{meyer2003vami,
	address = {Berlin, Heidelberg},
	title = {Discrete {Differential}-{Geometry} {Operators} for {Triangulated} 2-{Manifolds}},
	isbn = {978-3-642-05682-6 978-3-662-05105-4},
	url = {http://link.springer.com/10.1007/978-3-662-05105-4_2},
	doi = {10.1007/978-3-662-05105-4_2},
	abstract = {This paper proposes a uniﬁed and consistent set of ﬂexible tools to approximate important geometric attributes, including normal vectors and curvatures on arbitrary triangle meshes. We present a consistent derivation of these ﬁrst and second order diﬀerential properties using averaging Voronoi cells and the mixed Finite-Element/Finite-Volume method, and compare them to existing formulations. Building upon previous work in discrete geometry, these operators are closely related to the continuous case, guaranteeing an appropriate extension from the continuous to the discrete setting: they respect most intrinsic properties of the continuous diﬀerential operators. We show that these estimates are optimal in accuracy under mild smoothness conditions, and demonstrate their numerical quality. We also present applications of these operators, such as mesh smoothing, enhancement, and quality checking, and show results of denoising in higher dimensions, such as for tensor images.},
	language = {en},
	urldate = {2025-12-08},
	booktitle = {Visualization and {Mathematics} {III}},

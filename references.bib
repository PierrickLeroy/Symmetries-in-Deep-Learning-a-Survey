@misc{bantzis2025,
	title = {Saddle-{To}-{Saddle} {Dynamics} in {Deep} {ReLU} {Networks}: {Low}-{Rank} {Bias} in the {First} {Saddle} {Escape}},
	shorttitle = {Saddle-{To}-{Saddle} {Dynamics} in {Deep} {ReLU} {Networks}},
	url = {http://arxiv.org/abs/2505.21722},
	doi = {10.48550/arXiv.2505.21722},
	abstract = {When a deep ReLU network is initialized with small weights, GD is at first dominated by the saddle at the origin in parameter space. We study the so-called escape directions, which play a similar role as the eigenvectors of the Hessian for strict saddles. We show that the optimal escape direction features a low-rank bias in its deeper layers: the first singular value of the \${\textbackslash}ell\$-th layer weight matrix is at least \${\textbackslash}ell{\textasciicircum}\{{\textbackslash}frac\{1\}\{4\}\}\$ larger than any other singular value. We also prove a number of related results about these escape directions. We argue that this result is a first step in proving Saddle-to-Saddle dynamics in deep ReLU networks, where GD visits a sequence of saddles with increasing bottleneck rank.},
	urldate = {2026-01-20},
	publisher = {arXiv},
	author = {Bantzis, Ioannis and Simon, James B. and Jacot, Arthur},
	month = may,
	year = {2025},
	note = {arXiv:2505.21722 [cs]
TLDR: It is argued that this result is a first step in proving Saddle-to-Saddle dynamics in deep ReLU networks, where GD visits a sequence of saddles with increasing bottleneck rank, where GD visits a sequence of saddles with increasing bottleneck rank.},
	keywords = {/read, low rank bias, saddle to saddle},
}


@video{appliedalgebraictopologynetwork2021b,
  entrysubtype = {video},
  title = {Teresa {{Heiss}} (9/23/21): {{Geometry}} and {{Topology}} of {{Periodic Point Sets}}, for Example {{Crystals}}},
  shorttitle = {Teresa {{Heiss}} (9/23/21)},
  editor = {{Applied Algebraic Topology Network}},
  editortype = {director},
  date = {2021-09-23},
  url = {https://www.youtube.com/watch?v=LiGivu0maD8},
  urldate = {2024-03-07},
  abstract = {My talk will consist of two parts. Firstly, I will explain how tools of Computational Geometry and Topology, like Brillouin zones and order k persistent homology, can help in a material science application, namely in finding so-called crystal fingerprints that characterize crystalline materials uniquely and continuously. The second part will discuss the problem of defining persistent homology for periodic point sets. Despite the fact that periodic point sets consist of infinitely many points, we do not want to get persistence diagrams with multiplicities of value \$\textbackslash infty\$. Hence, a new definition is needed. I will show how the easiest definitions are unfortunately not invariant under different choices of representations of the periodic point set. Then, I will present a definition that is invariant and will discuss its advantages and disadvantages and future work about how to improve it. Joint work with Herbert Edelsbrunner, Alexey Garber, Vitaliy Kurlin, Georg Osang, Janos Pach, Morteza Saghafian, Phil Smith, and Mathijs Wintraecken.},
  keywords = {/on halt}
}


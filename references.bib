@online{vanspengler2023,
  title = {Poincar\textbackslash 'e {{ResNet}}},
  author = {family=Spengler, given=Max, prefix=van, useprefix=true and Berkhout, Erwin and Mettes, Pascal},
  date = {2023-12-19},
  eprint = {2303.14027},
  eprinttype = {arXiv},
  eprintclass = {cs},
  doi = {10.48550/arXiv.2303.14027},
  url = {http://arxiv.org/abs/2303.14027},
  urldate = {2024-07-18},
  abstract = {This paper introduces an end-to-end residual network that operates entirely on the Poincar\textbackslash 'e ball model of hyperbolic space. Hyperbolic learning has recently shown great potential for visual understanding, but is currently only performed in the penultimate layer(s) of deep networks. All visual representations are still learned through standard Euclidean networks. In this paper we investigate how to learn hyperbolic representations of visual data directly from the pixel-level. We propose Poincar\textbackslash 'e ResNet, a hyperbolic counterpart of the celebrated residual network, starting from Poincar\textbackslash 'e 2D convolutions up to Poincar\textbackslash 'e residual connections. We identify three roadblocks for training convolutional networks entirely in hyperbolic space and propose a solution for each: (i) Current hyperbolic network initializations collapse to the origin, limiting their applicability in deeper networks. We provide an identity-based initialization that preserves norms over many layers. (ii) Residual networks rely heavily on batch normalization, which comes with expensive Fr\textbackslash 'echet mean calculations in hyperbolic space. We introduce Poincar\textbackslash 'e midpoint batch normalization as a faster and equally effective alternative. (iii) Due to the many intermediate operations in Poincar\textbackslash 'e layers, we lastly find that the computation graphs of deep learning libraries blow up, limiting our ability to train on deep hyperbolic networks. We provide manual backward derivations of core hyperbolic operations to maintain manageable computation graphs.},
  pubstate = {prepublished},
  keywords = {/unread,hyperbolic geometry},
  file = {/home/pierrick/OneDrive/zotero-library/2023/van Spengler/van Spengler et al. - 2023 - Poincar'e ResNet.pdf}
}


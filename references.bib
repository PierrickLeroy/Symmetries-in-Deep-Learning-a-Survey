@inproceedings{odena2019p3icml,
  title = {{{TensorFuzz}}: {{Debugging Neural Networks}} with {{Coverage-Guided Fuzzing}}},
  shorttitle = {{{TensorFuzz}}},
  booktitle = {Proceedings of the 36th {{International Conference}} on {{Machine Learning}}},

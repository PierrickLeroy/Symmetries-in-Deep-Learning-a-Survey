@online{scherlis2025,
  title = {Estimating the {{Probability}} of {{Sampling}} a {{Trained Neural Network}} at {{Random}}},
  author = {Scherlis, Adam and Belrose, Nora},
  date = {2025-04-08},
  eprint = {2501.18812},

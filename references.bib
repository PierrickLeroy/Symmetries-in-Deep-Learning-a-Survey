  keywords = {/on halt,neurips 2024},
  file = {/home/pierrick/OneDrive/zotero-library/2024/Spinner/Spinner et al. - 2024 - Lorentz-Equivariant Geometric Algebra Transformers for High-Energy Physics.pdf}
}


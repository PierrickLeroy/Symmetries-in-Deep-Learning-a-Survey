@inproceedings{barbe2021mlkdd,
	address = {Cham},
	series = {Lecture {Notes} in {Computer} {Science}},
	title = {Graph {Diffusion} {Wasserstein} {Distances}},
	isbn = {978-3-030-67661-2},
	doi = {10.1007/978-3-030-67661-2_34},
	abstract = {Optimal Transport (OT) for structured data has received much attention in the machine learning community, especially for addressing graph classification or graph transfer learning tasks. In this paper, we present the Diffusion Wasserstein (\$\${\textbackslash}mathtt \{DW\}\$\$DW) distance, as a generalization of the standard Wasserstein distance to undirected and connected graphs where nodes are described by feature vectors. \$\${\textbackslash}mathtt \{DW\}\$\$DWis based on the Laplacian exponential kernel and benefits from the heat diffusion to catch both structural and feature information from the graphs. We further derive lower/upper bounds on \$\${\textbackslash}mathtt \{DW\}\$\$DWand show that it can be directly plugged into the Fused Gromov Wasserstein (\$\${\textbackslash}mathtt \{FGW\}\$\$FGW) distance that has been recently proposed, leading - for free - to a DifFused Gromov Wasserstein distance (\$\${\textbackslash}mathtt \{DFGW\}\$\$DFGW) that allows a significant performance boost when solving graph domain adaptation tasks.},
	language = {en},
	booktitle = {Machine {Learning} and {Knowledge} {Discovery} in {Databases}},
	publisher = {Springer International Publishing},
	author = {Barbe, Amélie and Sebban, Marc and Gonçalves, Paulo and Borgnat, Pierre and Gribonval, Rémi},
	editor = {Hutter, Frank and Kersting, Kristian and Lijffijt, Jefrey and Valera, Isabel},
	year = {2021},
	keywords = {/unread, EPFL-statement},
	pages = {577--592},
}

@inproceedings{foley2022p2aacccs,
	address = {New York, NY, USA},
	series = {{ASIA} {CCS} '22},
	title = {Autonomous {Network} {Defence} using {Reinforcement} {Learning}},
	isbn = {978-1-4503-9140-5},
	url = {https://doi.org/10.1145/3488932.3527286},
	doi = {10.1145/3488932.3527286},
	abstract = {In the network security arms race, the defender is significantly disadvantaged as they need to successfully detect and counter every malicious attack. In contrast, the attacker needs to succeed only once. To level the playing field, we investigate the effectiveness of autonomous agents in a realistic network defence scenario. We first outline the problem, provide the background on reinforcement learning and detail our proposed agent design. Using a network environment simulation, with 13 hosts spanning 3 subnets, we train a novel reinforcement learning agent and show that it can reliably defend continual attacks by two advanced persistent threat (APT) red agents: one with complete knowledge of the network layout and another which must discover resources through exploration but is more general.},
	urldate = {2023-03-17},
	booktitle = {Proceedings of the 2022 {ACM} on {Asia} {Conference} on {Computer} and {Communications} {Security}},
	publisher = {Association for Computing Machinery},

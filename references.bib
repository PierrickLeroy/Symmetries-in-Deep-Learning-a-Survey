  keywords = {/on halt,Computer Science - Artificial Intelligence,Computer Science - Machine Learning,pseudo euclidean space},
  file = {/home/pierrick/OneDrive/zotero-library/2024/Zhdanov/Zhdanov et al. - 2024 - Clifford-Steerable Convolutional Neural Networks.pdf}

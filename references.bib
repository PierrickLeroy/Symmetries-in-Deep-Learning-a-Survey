  annotation = {0 citations (Semantic Scholar/arXiv) [2024-01-31]},
  file = {/home/pierrick/OneDrive/zotero-library/2022/Belton/Belton et al. - 2022 - Extremal Event Graphs A (Stable) Tool for Analyzing Noisy Time Series Data.pdf}
}


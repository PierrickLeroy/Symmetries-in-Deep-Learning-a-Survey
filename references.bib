
@article{sanborn2022,
	title = {Bispectral {Neural} {Networks}},
	copyright = {Creative Commons Attribution Non Commercial No Derivatives 4.0 International},
	url = {https://arxiv.org/abs/2209.03416},
	doi = {10.48550/ARXIV.2209.03416},
	abstract = {We present a neural network architecture, Bispectral Neural Networks (BNNs) for learning representations that are invariant to the actions of compact commutative groups on the space over which a signal is defined. The model incorporates the ansatz of the bispectrum, an analytically defined group invariant that is complete -- that is, it preserves all signal structure while removing only the variation due to group actions. Here, we demonstrate that BNNs are able to simultaneously learn groups, their irreducible representations, and corresponding equivariant and complete-invariant maps purely from the symmetries implicit in data. Further, we demonstrate that the completeness property endows these networks with strong invariance-based adversarial robustness. This work establishes Bispectral Neural Networks as a powerful computational primitive for robust invariant representation learning},
	urldate = {2024-05-11},
	publisher = {[object Object]},
	author = {Sanborn, Sophia and Shewmake, Christian and Olshausen, Bruno and Hillar, Christopher},
	year = {2022},
	note = {GSCC: 0000026 2026-05-16T14:47:19.830Z 0.11 
Version Number: 5},
	keywords = {/unread},
}

@article{ennes2025fcm,
	title = {{LieDetect}: {Detection} of {Representation} {Orbits} of {Compact} {Lie} {Groups} {From} {Point} {Clouds}},
	issn = {1615-3383},
	shorttitle = {{LieDetect}},
	url = {https://doi.org/10.1007/s10208-025-09728-4},
	doi = {10.1007/s10208-025-09728-4},
	abstract = {We suggest a new algorithm to estimate representations of compact Lie groups from finite samples of their orbits. Different from other reported techniques, our method allows the retrieval of the precise representation type as a direct sum of irreducible representations. Moreover, the knowledge of the representation type permits the reconstruction of its orbit, which is useful for identifying the Lie group that generates the action, from a finite list of candidates. Our algorithm is general for any compact Lie group, but only instantiations for SO(2), \$\$T{\textasciicircum}d\$\$, SU(2), and SO(3) are considered. Theoretical guarantees of robustness in terms of Hausdorff and Wasserstein distances are derived. Our tools are drawn from geometric measure theory, computational geometry, and optimization on matrix manifolds. The algorithm is tested for synthetic data up to dimension 32, as well as real-life applications in image analysis, harmonic analysis, density estimation, equivariant neural networks, chemical conformational spaces, and classical mechanics systems, achieving very accurate results.},
	language = {en},
	urldate = {2025-10-28},
	journal = {Foundations of Computational Mathematics},
	author = {Ennes, Henrique and Tinarrage, Raphaël},
	month = sep,
	year = {2025},
	keywords = {/read, data symmetry, symmetry, symmetry discovery},
}


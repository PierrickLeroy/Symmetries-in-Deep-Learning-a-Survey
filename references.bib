@online{vanlaarhoven2017,
  title = {L2 {{Regularization}} versus {{Batch}} and {{Weight Normalization}}},
  author = {family=Laarhoven, given=Twan, prefix=van, useprefix=true},
  date = {2017-06-16},
  eprint = {1706.05350},
  eprinttype = {arXiv},

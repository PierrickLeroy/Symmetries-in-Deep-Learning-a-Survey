@article{oktay2018itmi,
  title = {Anatomically {{Constrained Neural Networks}} ({{ACNNs}}): {{Application}} to {{Cardiac Image Enhancement}} and {{Segmentation}}},
  shorttitle = {Anatomically {{Constrained Neural Networks}} ({{ACNNs}})},
  author = {Oktay, Ozan and Ferrante, Enzo and Kamnitsas, Konstantinos and Heinrich, Mattias and Bai, Wenjia and Caballero, Jose and Cook, Stuart A. and family=Marvao, given=Antonio, prefix=de, useprefix=true and Dawes, Timothy and O‘Regan, Declan P. and Kainz, Bernhard and Glocker, Ben and Rueckert, Daniel},

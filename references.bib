@article{gao2021ijprs,
  title = {{{SUM}}: {{A Benchmark Dataset}} of {{Semantic Urban Meshes}}},
  shorttitle = {{{SUM}}},
  author = {Gao, Weixiao and Nan, Liangliang and Boom, Bas and Ledoux, Hugo},
  date = {2021-09},
  journaltitle = {ISPRS Journal of Photogrammetry and Remote Sensing},
  volume = {179},
  eprint = {2103.00355},

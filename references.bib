@article{truong2024a,
	title = {Weisfeiler and {Lehman} {Go} {Paths}: {Learning} {Topological} {Features} via {Path} {Complexes}},
	volume = {38},
	issn = {2374-3468, 2159-5399},
	shorttitle = {Weisfeiler and {Lehman} {Go} {Paths}},
	url = {http://arxiv.org/abs/2308.06838},
	doi = {10.1609/aaai.v38i14.29463},
	abstract = {Graph Neural Networks (GNNs), despite achieving remarkable performance across different tasks, are theoretically bounded by the 1-Weisfeiler-Lehman test, resulting in limitations in terms of graph expressivity. Even though prior works on topological higher-order GNNs overcome that boundary, these models often depend on assumptions about substructures of graphs. Specifically, topological GNNs leverage the prevalence of cliques, cycles, and rings to enhance the message-passing procedure. Our study presents a novel perspective by focusing on simple paths within graphs during the topological message-passing process, thus liberating the model from restrictive inductive biases. We prove that by lifting graphs to path complexes, our model can generalize the existing works on topology while inheriting several theoretical results on simplicial complexes and regular cell complexes. Without making prior assumptions about graph sub-structures, our method outperforms earlier works in other topological domains and achieves state-of-the-art results on various benchmarks.},
	language = {en},
	number = {14},
	urldate = {2024-07-04},
	journal = {Proceedings of the AAAI Conference on Artificial Intelligence},
	author = {Truong, Quang and Chin, Peter},
	month = mar,
	year = {2024},
	note = {arXiv:2308.06838 [cs]},
	keywords = {/unread, path, path complex},
	pages = {15382--15391},
}


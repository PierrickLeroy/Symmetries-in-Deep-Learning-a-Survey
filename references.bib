@online{boccato2023,
  title = {{{4Ward}}: A {{Relayering Strategy}} for {{Efficient Training}} of {{Arbitrarily Complex Directed Acyclic Graphs}}},
  shorttitle = {{{4Ward}}},
  author = {Boccato, Tommaso and Ferrante, Matteo and Duggento, Andrea and Toschi, Nicola},
  date = {2023-10-23},
  eprint = {2209.02037},

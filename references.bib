@article{grigsby2022sjaag,
	title = {On {Transversality} of {Bent} {Hyperplane} {Arrangements} and the {Topological} {Expressiveness} of {ReLU} {Neural} {Networks}},
	volume = {6},
	url = {https://epubs.siam.org/doi/abs/10.1137/20M1368902},
	doi = {10.1137/20M1368902},
	abstract = {.We present an algorithm which computes the face poset of the canonical polyhedral complex, the universal object into which a feedforward, fully connected ReLU neural network (also known as a multilayer perceptron, or MLP) decomposes its input space. Under certain transversality conditions between layers, which are satisfied on a full-measure subset of the parameter space of these ReLU neural networks, we show that vectors recording the signs of the activity of the intermediate layers of a neural network on only the vertices of the polyhedral complex are sufficient to determine the entire face poset. The algorithm which computes these sign vectors is more numerically stable than naive polyhedral intersection. For randomly initialized networks the algorithm’s expected time complexity grows polynomially with respect to the number of intermediate neurons, but exponentially with respect to input dimension. We demonstrate how its output can be used to obtain the exact topology of the decision boundary of binary classification networks with low-dimensional inputs, and empirically observe untrained networks at random initialization, finding that width alone does not seem to change the variability of observed decision boundary topology, but width in the presence of depth does.},
	number = {2},
	urldate = {2025-10-27},
	journal = {SIAM Journal on Applied Algebra and Geometry},
	publisher = {Society for Industrial and Applied Mathematics},
	author = {Grigsby, J. Elisenda and Lindsey, Kathryn},
	month = jun,
	year = {2022},
	keywords = {/unread, ReLU network},
	pages = {216--242},
}

@misc{bartlett2019,
	title = {Nearly-tight {VC}-dimension and pseudodimension bounds for piecewise linear neural networks},
	url = {http://arxiv.org/abs/1703.02930},
	doi = {10.48550/arXiv.1703.02930},
	abstract = {We prove new upper and lower bounds on the VC-dimension of deep neural networks with the ReLU activation function. These bounds are tight for almost the entire range of parameters. Letting \$W\$ be the number of weights and \$L\$ be the number of layers, we prove that the VC-dimension is \$O(W L {\textbackslash}log(W))\$, and provide examples with VC-dimension \$Ω( W L {\textbackslash}log(W/L) )\$. This improves both the previously known upper bounds and lower bounds. In terms of the number \$U\$ of non-linear units, we prove a tight bound \$Θ(W U)\$ on the VC-dimension. All of these bounds generalize to arbitrary piecewise linear activation functions, and also hold for the pseudodimensions of these function classes. Combined with previous results, this gives an intriguing range of dependencies of the VC-dimension on depth for networks with different non-linearities: there is no dependence for piecewise-constant, linear dependence for piecewise-linear, and no more than quadratic dependence for general piecewise-polynomial.},
	urldate = {2025-06-18},
	publisher = {arXiv},
	author = {Bartlett, Peter L. and Harvey, Nick and Liaw, Chris and Mehrabian, Abbas},
	month = jun,
	year = {2019},
	note = {arXiv:1703.02930 [cs]},
	keywords = {/read, ReLU network, VC dimension},
}


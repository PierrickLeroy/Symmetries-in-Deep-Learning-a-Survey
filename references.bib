@online{borde2024,
  title = {Neural {{Spacetimes}} for {{DAG Representation Learning}}},
  author = {Borde, Haitz Sáez de Ocáriz and Kratsios, Anastasis and Law, Marc T. and Dong, Xiaowen and Bronstein, Michael},

	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/cgf.12864
TLDR: This report provides a systematic overview of directional field synthesis for graphics applications, the challenges it poses, and the methods developed in recent years to address these challenges.},
	keywords = {/read, Dirichlet energy, vector field, ⭐},
	pages = {545--572},
}


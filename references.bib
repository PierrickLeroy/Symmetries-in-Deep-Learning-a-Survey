@inproceedings{kaur2023po,
  title = {On the {{Maximum Hessian Eigenvalue}} and {{Generalization}}},
  booktitle = {Proceedings On},
  author = {Kaur, Simran and Cohen, Jeremy and Lipton, Zachary Chase},

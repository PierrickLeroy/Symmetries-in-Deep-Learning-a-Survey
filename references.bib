@article{ripart2025jn,
	title = {Detection of {Epileptogenic} {Focal} {Cortical} {Dysplasia} {Using} {Graph} {Neural} {Networks}: {A} {MELD} {Study}},
	volume = {82},
	issn = {2168-6157},
	shorttitle = {Detection of {Epileptogenic} {Focal} {Cortical} {Dysplasia} {Using} {Graph} {Neural} {Networks}},
	doi = {10.1001/jamaneurol.2024.5406},
	abstract = {IMPORTANCE: A leading cause of surgically remediable, drug-resistant focal epilepsy is focal cortical dysplasia (FCD). FCD is challenging to visualize and often considered magnetic resonance imaging (MRI) negative. Existing automated methods for FCD detection are limited by high numbers of false-positive predictions, hampering their clinical utility.
OBJECTIVE: To evaluate the efficacy and interpretability of graph neural networks in automatically detecting FCD lesions on MRI scans.
DESIGN, SETTING, AND PARTICIPANTS: In this multicenter diagnostic study, retrospective MRI data were collated from 23 epilepsy centers worldwide between 2018 and 2022, as part of the Multicenter Epilepsy Lesion Detection (MELD) Project, and analyzed in 2023. Data from 20 centers were split equally into training and testing cohorts, with data from 3 centers withheld for site-independent testing. A graph neural network (MELD Graph) was trained to identify FCD on surface-based features. Network performance was compared with an existing algorithm. Feature analysis, saliencies, and confidence scores were used to interpret network predictions. In total, 34 surface-based MRI features and manual lesion masks were collated from participants, 703 patients with FCD-related epilepsy and 482 controls, and 57 participants were excluded during MRI quality control.
MAIN OUTCOMES AND MEASURES: Sensitivity, specificity, and positive predictive value (PPV) of automatically identified lesions.
RESULTS: In the test dataset, the MELD Graph had a sensitivity of 81.6\% in histopathologically confirmed patients seizure-free 1 year after surgery and 63.7\% in MRI-negative patients with FCD. The PPV of putative lesions from the 260 patients in the test dataset (125 female [48\%] and 135 male [52\%]; mean age, 18.0 [IQR, 11.0-29.0] years) was 67\% (70\% sensitivity; 60\% specificity), compared with 39\% (67\% sensitivity; 54\% specificity) using an existing baseline algorithm. In the independent test cohort (116 patients; 62 female [53\%] and 54 male [47\%]; mean age, 22.5 [IQR, 13.5-27.5] years), the PPV was 76\% (72\% sensitivity; 56\% specificity), compared with 46\% (77\% sensitivity; 47\% specificity) using the baseline algorithm. Interpretable reports characterize lesion location, size, confidence, and salient features.
CONCLUSIONS AND RELEVANCE: In this study, the MELD Graph represented a state-of-the-art, openly available, and interpretable tool for FCD detection on MRI scans with significant improvements in PPV. Its clinical implementation holds promise for early diagnosis and improved management of focal epilepsy, potentially leading to better patient outcomes.},
	language = {eng},
	number = {4},
	journal = {JAMA neurology},
	author = {Ripart, Mathilde and Spitzer, Hannah and Williams, Logan Z. J. and Walger, Lennart and Chen, Andrew and Napolitano, Antonio and Rossi-Espagnet, Camilla and Foldes, Stephen T. and Hu, Wenhan and Mo, Jiajie and Likeman, Marcus and Rüber, Theodor and Caligiuri, Maria Eugenia and Gambardella, Antonio and Guttler, Christopher and Tietze, Anna and Lenge, Matteo and Guerrini, Renzo and Cohen, Nathan T. and Wang, Irene and Kloster, Ane and Pinborg, Lars H. and Hamandi, Khalid and Jackson, Graeme and Tortora, Domenico and Tisdall, Martin and Conde-Blanco, Estefania and Pariente, Jose C. and Perez-Enriquez, Carmen and Gonzalez-Ortiz, Sofia and Mullatti, Nandini and Vecchiato, Katy and Liu, Yawu and Kalviainen, Reetta and Sokol, Drahoslav and Shetty, Jay and Sinclair, Benjamin and Vivash, Lucy and Willard, Anna and Winston, Gavin P. and Yasuda, Clarissa and Cendes, Fernando and Shinohara, Russell T. and Duncan, John S. and Cross, J. Helen and Baldeweg, Torsten and Robinson, Emma C. and Iglesias, Juan Eugenio and Adler, Sophie and Wagstyl, Konrad and {MELD FCD writing group} and Fawaz, Abdulah and De Benedictis, Alessandro and De Palma, Luca and Zhang, Kai and Labate, Angelo and Barba, Carmen and You, Xiaozhen and Gaillard, William D. and Tang, Yingying and Wang, Shan and Davies, Shirin and Semmelroch, Mira and Severino, Mariasavina and Striano, Pasquale and Chari, Aswin and D'Arco, Felice and Mankad, Kshitij and Bargallo, Nuria and Pascual-Diaz, Saul and Delgado-Martinez, Ignacio and O'Muircheartaigh, Jonathan and Abela, Eugenio and Kandasamy, Jothy and McLellan, Ailsa and Desmond, Patricia and Lui, Elaine and O'Brien, Terence J. and Whitaker, Kirstie},
	month = feb,
	year = {2025},
	keywords = {/on halt},
	pages = {397--406},
}

@misc{magalhaes2018bm,
	title = {Bayesian {Linear} {Regression}, {Maximum} {Likelihood} and {Maximum}-{A}-{Priori}},
	url = {https://brunomaga.github.io/Bayesian-Linear-Regression},
	abstract = {Bayesian methods allows us to perform modelling of an input to an output by providing a measure of uncertainty or “how sure we are”, based on the seen data. Unlike most frequentist methods commonly used, where the outpt of the method is a set of best fit parameters, the output of a Bayesian regression is a probability distribution of each model parameter, called the posterior distribution. For the sake of comparison, take the example of a simple linear regression {\textbackslash}(y = mx + b{\textbackslash}). On the frequentist approach, one tries to find the constant that define the slope {\textbackslash}(m{\textbackslash}) and bias {\textbackslash}(b{\textbackslash}) values, with {\textbackslash}(m {\textbackslash}in {\textbackslash}mathbb\{R\}{\textbackslash}) and {\textbackslash}(b {\textbackslash}in {\textbackslash}mathbb\{R\}{\textbackslash}). On the other hand, the Bayesian approach would also compute {\textbackslash}(y = mx + b{\textbackslash}), however, {\textbackslash}(b{\textbackslash}) and {\textbackslash}(m{\textbackslash}) are not assumed to be constant values but drawn from probability distributions instead. The parameters of those probabilities define the values to be learnt (or tuned) during training. A common approach is to assume as prior knowledge that {\textbackslash}(m{\textbackslash}) and {\textbackslash}(b{\textbackslash}) are independent and normally distributed — i.e. {\textbackslash}(b {\textbackslash}thicksim {\textbackslash}mathcal\{N\}({\textbackslash}mu\_\{b\}, {\textbackslash}sigma{\textasciicircum}2\_\{b\}){\textbackslash}) and {\textbackslash}(w {\textbackslash}thicksim {\textbackslash}mathcal\{N\}({\textbackslash}mu\_\{w\}, {\textbackslash}sigma{\textasciicircum}2\_\{w\}){\textbackslash}) — and the parameters to be learnt would then be all {\textbackslash}({\textbackslash}mu{\textbackslash}) and {\textbackslash}({\textbackslash}sigma{\textbackslash}). Additionally, on a Bayesian approach we can also add the model of the noise (inverse of the precision) constant {\textbackslash}({\textbackslash}varepsilon{\textbackslash}) that models how noisy our data may be, by computing {\textbackslash}(y = mx + b + {\textbackslash}varepsilon{\textbackslash}) instead, with {\textbackslash}({\textbackslash}varepsilon {\textbackslash}thicksim {\textbackslash}mathcal\{N\}(0, {\textbackslash}sigma{\textasciicircum}2\_\{{\textbackslash}varepsilon\}){\textbackslash}). Apart from the uncertainty quantification, another benefit of Bayesian is the possibility of online learning, i.e. a continuous update of the trained model (from previously-seen data) by looking at only the new data. This is a handy feature for e.g. datasets that are purged periodically. Refresher: Normal distribution A probability distribution is a mathematical function that provides the probabilities of occurrence of different possible outcomes in an experiment. In the following post, we methods will be solely based on the Normal distribution defined for an input {\textbackslash}(x{\textbackslash}) by: {\textbackslash}(p(x {\textbackslash}mid {\textbackslash}mu, {\textbackslash}sigma ) = {\textbackslash}frac\{1\}\{ {\textbackslash}sqrt\{2 {\textbackslash}pi {\textbackslash}sigma{\textasciicircum}2\} \} {\textbackslash},{\textbackslash}, exp {\textbackslash}left( - {\textbackslash}frac\{(x - {\textbackslash}mu){\textasciicircum}2\}\{2 {\textbackslash}sigma{\textasciicircum}2\} {\textbackslash}right){\textbackslash}) for a distribution with mean {\textbackslash}({\textbackslash}mu{\textbackslash}) and standard deviation {\textbackslash}({\textbackslash}sigma{\textbackslash}) on an univariate notation, or {\textbackslash}(p(x {\textbackslash}mid {\textbackslash}mu, {\textbackslash}Sigma ) = {\textbackslash}left({\textbackslash}frac\{1\}\{2 {\textbackslash}pi\}{\textbackslash}right){\textasciicircum}\{-D/2\} {\textbackslash},{\textbackslash}, det({\textbackslash}Sigma){\textasciicircum}\{-1/2\} exp {\textbackslash}left( - {\textbackslash}frac\{1\}\{2\}(x - {\textbackslash}mu){\textasciicircum}T {\textbackslash}Sigma{\textasciicircum}\{-1\} (x-{\textbackslash}mu) {\textbackslash}right){\textbackslash}) with mean vector {\textbackslash}({\textbackslash}mu{\textbackslash}) and covariance matrix {\textbackslash}({\textbackslash}Sigma{\textbackslash}) on its multivariate (matrix) notation Bayes Theorem From the field of probability, the product rule tells us that {\textbackslash}(p(A, B) = p(A) p(B{\textbackslash}mid A){\textbackslash}). By symmetry we have that {\textbackslash}(p(B,A) = p(B) p(A{\textbackslash}mid B){\textbackslash}). By equating both right hand sides of the equations and re-arranging the terms we obtain the Bayes Theorem: {\textbackslash}begin\{equation\} {\textbackslash}text\{posterior\} = {\textbackslash}frac\{{\textbackslash}text\{likelihood\}{\textbackslash}, {\textbackslash}times {\textbackslash}, {\textbackslash}text\{prior\}\}\{{\textbackslash}text\{evidence\}\} = p(A{\textbackslash}mid B) = {\textbackslash}frac\{p(B{\textbackslash}mid A) p(A)\}\{p(B)\}{\textbackslash}end\{equation\} In Machine Learning, we are mostly interested in how the parameters of the model {\textbackslash}({\textbackslash}theta{\textbackslash}) relate to the data {\textbackslash}(X{\textbackslash}): [p({\textbackslash}theta {\textbackslash}mid X) = {\textbackslash}frac\{p(X{\textbackslash}mid {\textbackslash}theta) p({\textbackslash}theta)\}\{p(X)\} {\textbackslash}propto p(X {\textbackslash}mid {\textbackslash}theta) p({\textbackslash}theta) {\textbackslash}label\{eq\_prior\_AB\}] ,where evidence is {\textbackslash}(p(X) = {\textbackslash}int p(X {\textbackslash}mid {\textbackslash}theta) p({\textbackslash}theta) d{\textbackslash}theta = {\textbackslash}mathbb\{E\}\_\{{\textbackslash}theta\}[ p(X {\textbackslash}mid {\textbackslash}theta) ]{\textbackslash}) The idea behing Bayes Theorem in ML is to invert the relationship between the parameters {\textbackslash}(θ{\textbackslash}) and the data {\textbackslash}(X{\textbackslash}) to obtain the posterior; An important theoream called the Bernstein-von Mises Theorem states that: for a sufficiently large sample size, the posterior distribution becomes independent of the prior (as long as the prior is neither 0 or 1) ie for a sufficiently large dataset, the prior just doesnt matter much anymore as the current data has enough information; if we let the datapoints go to infitiny, the posterior distribution will go to normal distribution, where the mean will be the maximum likelihood estimator; this is a restatement of the central limit theorem, where the posterior distribution becomes the likelihood function; ie the effect of the prior decreases as the data increases; we typically want to maximize the posterior, so we can drop the evidence term (as it’s independent of {\textbackslash}({\textbackslash}theta{\textbackslash})) and compute only the maximum of the term {\textbackslash}(p(X {\textbackslash}mid {\textbackslash}theta) p({\textbackslash}theta){\textbackslash}). There are two main optimization problems that we discuss in Bayesian methods: Maximum Likelihood Estimator (MLE) and Maximum-a-Posteriori (MAP). Maximum Likelihood Estimator (MLE) (In case the following reductions cause some confusion, check the appendix at the bottom of the page for the rules used, or The Matrix Cookbook for a more detailed overview of matrix operations.) When we try to find how likely is for an output {\textbackslash}(y{\textbackslash}) to belong to a model defined by data {\textbackslash}(X{\textbackslash}), weights {\textbackslash}(w{\textbackslash}) and model parameters {\textbackslash}({\textbackslash}sigma{\textbackslash}) (if any), or maximize the likelihood {\textbackslash}(p(y{\textbackslash}mid w, X, {\textbackslash}sigma{\textasciicircum}2){\textbackslash}), we perform a Maximum Likelihood Estimator (MLE). Maximizing the likelihood means maximizing the probability that models the training data, given the model parameters, as: [w\_\{MLE\} = argmax\_w {\textbackslash},{\textbackslash}, p(y {\textbackslash}mid w, X)] Let us interpret what the probability density {\textbackslash}(p(x {\textbackslash}mid θ){\textbackslash}) is modeling for a fixed value of θ. It is a distribution that models the uncertainty of the data for a given parameter setting. In a complementary view, if we consider the data to be fixed (because it has been observed), and we vary the parameters θ, what does the MLE tell us? It tells us how likely a particular setting of θ is for the observations x. Based on this second view, the maximum likelihood estimator gives us the most likely parameter θ for the set of data. (MML book, section 8.3.1). When the distribution of the prior and posterior are computationally tractable, the optimization of the parameters that define the distribution can be performed using the coordinate ascent method, an iterative method that was covered in other post. In practice we perform and iterative partial derivatives of the prior/posterior for the model parameters (e.g. mean {\textbackslash}({\textbackslash}mu{\textbackslash}) and standard deviation {\textbackslash}({\textbackslash}sigma{\textbackslash}) in a Gaussian environment) and move our weight estimation towards the direction of lowest loss. To simplify the computation, we perform the log-trick and place the term to optimize into a log function. We can do this because {\textbackslash}(log{\textbackslash}) is a monotonically-increasing function, thus applying it to any function won’t change the input values where the minimum or maximum of the solution (ie where gradient is zero). Moreover, since Gaussian distribution is represented by a product of exponentials, by applying the {\textbackslash}(log{\textbackslash}) function we bring the power term out of the exponential, making its computation simpler and faster. In practice, we apply the log-trick to the function we want to minimize and get: [{\textbackslash}begin\{align\} -{\textbackslash}log {\textbackslash},{\textbackslash}, p(y {\textbackslash}mid w, X) \& = -log {\textbackslash}prod\_\{n=1\}{\textasciicircum}N p(y\_n {\textbackslash}mid w\_n, X\_n) \& = - {\textbackslash}sum\_\{n=1\}{\textasciicircum}N log {\textbackslash},{\textbackslash}, p(y\_n {\textbackslash}mid w\_n, X\_n) {\textbackslash}end\{align\}] I.e. we turn a log of products into a sum of logs. In the linear regression model, the likelihood is Gaussian, due to the Gaussian noise term {\textbackslash}({\textbackslash}varepsilon {\textbackslash}thicksim {\textbackslash}mathcal\{N\}(0, {\textbackslash}sigma{\textasciicircum}2\_\{{\textbackslash}varepsilon\}){\textbackslash}). Therefore: [{\textbackslash}begin\{align\} log {\textbackslash},{\textbackslash}, p(y {\textbackslash}mid w, X, {\textbackslash}sigma{\textasciicircum}2) \& = {\textbackslash}log {\textbackslash}left( {\textbackslash}frac\{1\}\{ {\textbackslash}sqrt\{2 {\textbackslash}pi {\textbackslash}sigma{\textasciicircum}2\} \} {\textbackslash},{\textbackslash}, exp {\textbackslash}left( - {\textbackslash}frac\{(y\_n - x\_n{\textasciicircum}Tw){\textasciicircum}2\}\{2 {\textbackslash}sigma{\textasciicircum}2\} {\textbackslash}right) {\textbackslash}right) \& = - {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} (y\_n - x{\textasciicircum}T\_n w){\textasciicircum}2 + const {\textbackslash}end\{align\} {\textbackslash}label\{eq\_lr\_likelihood\}] where {\textbackslash}(const{\textbackslash}) includes all terms independent of {\textbackslash}(w{\textbackslash}). Using the negative of the previous log-likelihood, and ignoring the constants whose derivative is zero, we get the following loss function: [{\textbackslash}begin\{align\} L(w) \& = {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} {\textbackslash}sum\_\{n=1\}{\textasciicircum}N (y\_n - Xw){\textasciicircum}2 \& = {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} (y - Xw){\textasciicircum}T (y-Xw) {\textbackslash} \& = {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} {\textbar} y-Xw {\textbar}{\textasciicircum}2 {\textbackslash}end\{align\}] The second trick here is that the previous equation is quadratic in {\textbackslash}(w{\textbackslash}). Thus we have an unique global solution for minimizing the previous log-likelihood and compute the point of minimum loss as: [{\textbackslash}begin\{align\} \& {\textbackslash}frac\{dL\}\{dw\} = 0 {\textbackslash}Leftrightarrow \& 0 = {\textbackslash}frac\{d\}\{dw\} {\textbackslash}left( {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} (y-Xw){\textasciicircum}T(t-Xw) {\textbackslash}right) {\textbackslash}Leftrightarrow \& 0 = {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} {\textbackslash}frac\{d\}\{dw\} {\textbackslash}left( y{\textasciicircum}Ty - 2y{\textasciicircum}TXw + w{\textasciicircum}TX{\textasciicircum}TXw {\textbackslash}right) {\textbackslash}Leftrightarrow \& 0 = {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} {\textbackslash}left( -2y{\textasciicircum}TX + 2w{\textasciicircum}TX{\textasciicircum}TX {\textbackslash}right) {\textbackslash}Leftrightarrow \& y{\textasciicircum}TX = w{\textasciicircum}TX{\textasciicircum}TX {\textbackslash}Leftrightarrow \& w{\textasciicircum}T = y{\textasciicircum}TX (X{\textasciicircum}TX){\textasciicircum}\{-1\} {\textbackslash}Leftrightarrow \& w\_\{MLE\} = (X{\textasciicircum}TX){\textasciicircum}\{-1\}X{\textasciicircum}Ty {\textbackslash}end\{align\}] Note that this solution is independent of the noise variance {\textbackslash}({\textbackslash}sigma{\textasciicircum}2{\textbackslash}), and is the same as minimizing the Least Squares Problem, as we showed in a previous post, with the same closed-form solution {\textbackslash}(w = (X{\textasciicircum}TX){\textasciicircum}\{-1\} X{\textasciicircum}Ty{\textbackslash}). In practice, minimizing the Least Squares problem is equivalent to determining the most likely {\textbackslash}(w{\textbackslash}) under the assumption that {\textbackslash}(y{\textbackslash}) contains gaussian noise i.e. {\textbackslash}(y = wx + b + {\textbackslash}varepsilon{\textbackslash}), with {\textbackslash}({\textbackslash}varepsilon {\textbackslash}thicksim {\textbackslash}mathcal\{N\}(0, {\textbackslash}sigma{\textasciicircum}2){\textbackslash}). Adding regularization Regularizers can be added normally as in the non-Bayesian regression and may have as well an analytical solution. As an example, if we want ot add an {\textbackslash}(L\_2{\textbackslash})/Ridge regularizer: [{\textbackslash}begin\{align\} \& 0 = {\textbackslash}frac\{d\}\{dw\} {\textbackslash}left( L - {\textbackslash}frac\{{\textbackslash}alpha\}\{2\} w{\textasciicircum}Tw {\textbackslash}right) {\textbackslash}Leftrightarrow \& 0 = {\textbackslash}frac\{d\}\{dw\} {\textbackslash}left( - {\textbackslash}frac\{D\}\{2\} log ( 2 {\textbackslash}pi {\textbackslash}sigma{\textasciicircum}2) - {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} (y-Xw){\textasciicircum}T(y-Xw) - {\textbackslash}frac\{{\textbackslash}alpha\}\{2\} w{\textasciicircum}Tw {\textbackslash}right) {\textbackslash}Leftrightarrow \& w\_\{MLE\_reg\} = (X{\textasciicircum}TX + {\textbackslash}lambda I ){\textasciicircum}\{-1\} X{\textasciicircum}Ty {\textbackslash}end\{align\}] where {\textbackslash}({\textbackslash}lambda = {\textbackslash}alpha {\textbackslash}sigma{\textasciicircum}2{\textbackslash}), therefore the solution is now noise-dependent, contrarily to the previous use case. Note that we picked the regularizer constant {\textbackslash}({\textbackslash}alpha/2{\textbackslash}) on the first step to simplify the maths and cancel out the 2 when doing the derivative of the {\textbackslash}(w{\textasciicircum}Tw{\textbackslash}). Estimating noise variance So far we assumed the noise {\textbackslash}({\textbackslash}sigma{\textasciicircum}2{\textbackslash}) is known. However, we can use the same Maximum Likelihood principle to obtain the estimator {\textbackslash}({\textbackslash}sigma{\textasciicircum}2\_\{MLE\}{\textbackslash}) for the noise: [{\textbackslash}begin\{align\} log {\textbackslash},{\textbackslash}, p(y {\textbackslash}mid X, w, {\textbackslash}sigma{\textasciicircum}2) = \& {\textbackslash}sum\_\{n=1\}{\textasciicircum}N log {\textbackslash},{\textbackslash}, {\textbackslash}mathcal\{N\} (y\_n {\textbackslash}mid X\_nw, {\textbackslash}sigma{\textasciicircum}2) = \& {\textbackslash}sum\_\{n=1\}{\textasciicircum}N {\textbackslash}left( -{\textbackslash}frac\{1\}\{2\} log(2{\textbackslash}pi) -{\textbackslash}frac\{1\}\{2\} log({\textbackslash}sigma{\textasciicircum}2) -{\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\}(y\_n-X\_nw){\textasciicircum}2 {\textbackslash}right) = \& -{\textbackslash}frac\{N\}\{2\} log {\textbackslash}sigma{\textasciicircum}2 -{\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} {\textbackslash}sum\_\{n=1\}{\textasciicircum}N (y\_n - X\_nw){\textasciicircum}2 + const{\textbackslash} {\textbackslash}end\{align\}] The partial derivative of the loss with respect to {\textbackslash}({\textbackslash}sigma{\textasciicircum}2{\textbackslash}) and the MLE-estimation of {\textbackslash}({\textbackslash}sigma{\textasciicircum}2{\textbackslash}) is then: [{\textbackslash}begin\{align\} \& {\textbackslash}frac\{d {\textbackslash},{\textbackslash}, log {\textbackslash},{\textbackslash}, p(y {\textbackslash}mid X, w, {\textbackslash}sigma{\textasciicircum}2)\}\{d {\textbackslash}sigma{\textasciicircum}2\} = -{\textbackslash}frac\{N\}\{2 {\textbackslash}sigma{\textasciicircum}2\} + {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}4\} {\textbackslash}sum\_\{n=1\}{\textasciicircum}N (y\_n - X\_nw){\textasciicircum}2 = 0 {\textbackslash}Leftrightarrow \& {\textbackslash}frac\{N\}\{2 {\textbackslash}sigma{\textasciicircum}2\} = {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}4\} {\textbackslash}sum\_\{n=1\}{\textasciicircum}N (y\_n - X\_nw){\textasciicircum}2 {\textbackslash}Leftrightarrow \& {\textbackslash}sigma{\textasciicircum}2\_\{MLE\} = {\textbackslash}frac\{1\}\{N\} {\textbackslash}sum\_\{n=1\}{\textasciicircum}N (y\_n - X\_nw){\textasciicircum}2 {\textbackslash}end\{align\}] i.e. {\textbackslash}({\textbackslash}sigma{\textasciicircum}2{\textbackslash}) is the mean of the squared distance between observations and noise-free values. Maximum-a-Posteriori (MAP) Maximum likelihood without regularizer is prone to overfitting (details in section 9.2.2 of the Mathematics for Machine Learning book). In the occurrence of overfitting, we run into very large parameter values. To mitigate the effect of huge values, we can place the prior on the parameter space, and seek now the parameters to estimate the posterior distribution. If we have prior knowledge about the distribution of the parameters, we can multiply an additional term to the likelihood. This additional term is a prior probability distribution on parameters. For a given prior, after observing some data {\textbackslash}(x{\textbackslash}), how should we update the distribution of the parameters? In other words, how should we represent the fact that we have more specific knowledge of the parameters after observing data {\textbackslash}(x{\textbackslash})? This is called the Maximum-a-Posteriori estimation (MAP), and is obtained by applying the Bayes Theorem. The problem in hand is to find the parameters of the distribution that best represent the data. Adapting the equation {\textbackslash}ref\{eq\_prior\_AB\} of the prior to the problem of regression, we aim at computing: [p(w{\textbackslash}mid X, y) = {\textbackslash}frac\{p(y{\textbackslash}mid X, w) p(w)\}\{p(y {\textbackslash}mid X)\} {\textbackslash}propto p(y{\textbackslash}mid X, w) p(w) {\textbackslash}label\{posterior\_w\}] The computation steps are similar to log-trick applied to the MLE use case. The log-posterior is then: [log {\textbackslash},{\textbackslash}, p(w{\textbackslash}mid X, y) = log {\textbackslash},{\textbackslash}, p(y {\textbackslash}mid X, w) + log {\textbackslash},{\textbackslash}, p(w) + const] In practice, this is the sum of the log-likelihood {\textbackslash}(log {\textbackslash},{\textbackslash}, p(y {\textbackslash}mid X, w){\textbackslash}) and the log-prior {\textbackslash}(log {\textbackslash},{\textbackslash}, p(w){\textbackslash}), so the MAP estimation is a compromise between the prior and the likelihood. An alternative view is the idea of regularization, which introduces an additional term that biases the resulting parameters to be close to the original (MML book section 8.3.2). Similarly to the MLE, we compute the derivative of the negative log-posterior with respect to {\textbackslash}(w{\textbackslash}) as: [{\textbackslash}begin\{align\} \& - {\textbackslash}frac\{d {\textbackslash},{\textbackslash}, log {\textbackslash},{\textbackslash}, p( w {\textbackslash}mid X,y)\}\{dw\} = \& {\textbackslash}frac\{d {\textbackslash},{\textbackslash}, log {\textbackslash},{\textbackslash}, p( y {\textbackslash}mid X,w)\}\{dw\} - {\textbackslash}frac\{d {\textbackslash},{\textbackslash}, log {\textbackslash},{\textbackslash}, p(w)\}\{dw\} {\textbackslash} = \& {\textbackslash}frac\{d\}\{dw\} {\textbackslash}left( {\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\}(y-Xw){\textasciicircum}T(y-Xw) {\textbackslash}right) + {\textbackslash}frac\{d\}\{dw\} {\textbackslash}left( {\textbackslash}frac\{1\}\{2b{\textasciicircum}2\}w{\textasciicircum}Tw {\textbackslash}right) \& {\textbackslash}text\{(Linear Reg. likelihood (eq {\textbackslash}ref\{eq\_lr\_likelihood\}), and prior \} {\textbackslash}mathcal\{N\}(0, b{\textasciicircum}2 I) {\textbackslash}text\{)\} = \& {\textbackslash}frac\{1\}\{{\textbackslash}sigma{\textasciicircum}2\}(w{\textasciicircum}TX{\textasciicircum}TX-y{\textasciicircum}TX) + {\textbackslash}frac\{1\}\{b{\textasciicircum}2\}w{\textasciicircum}T \& {\textbackslash}text\{(First-order derivative, rule 3)\} {\textbackslash}end\{align\} {\textbackslash}label\{eq\_prior\_w\}] Computing the minimum value: [{\textbackslash}begin\{align\} \& {\textbackslash}frac\{1\}\{{\textbackslash}sigma{\textasciicircum}2\}(w{\textasciicircum}TX{\textasciicircum}TX-y{\textasciicircum}TX) + {\textbackslash}frac\{1\}\{b{\textasciicircum}2\}w{\textasciicircum}T = 0 {\textbackslash}Leftrightarrow \& w{\textasciicircum}T {\textbackslash}left( {\textbackslash}frac\{1\}\{{\textbackslash}sigma{\textasciicircum}2\}X{\textasciicircum}TX + {\textbackslash}frac\{1\}\{b{\textasciicircum}2\}I {\textbackslash}right) - {\textbackslash}frac\{1\}\{{\textbackslash}sigma{\textasciicircum}2\}y{\textasciicircum}TX = 0 {\textbackslash}Leftrightarrow \& w{\textasciicircum}T {\textbackslash}left( X{\textasciicircum}TX + {\textbackslash}frac\{{\textbackslash}sigma{\textasciicircum}2\}\{b{\textasciicircum}2\}I {\textbackslash}right) = y{\textasciicircum}TX {\textbackslash}Leftrightarrow \& w{\textasciicircum}T = y{\textasciicircum}TX {\textbackslash}left( X{\textasciicircum}TX + {\textbackslash}frac\{{\textbackslash}sigma{\textasciicircum}2\}\{b{\textasciicircum}2\}I {\textbackslash}right){\textasciicircum}\{-1\} {\textbackslash}Leftrightarrow \& w{\textasciicircum}T\_\{MAP\} = {\textbackslash}left( X{\textasciicircum}TX + {\textbackslash}frac\{{\textbackslash}sigma{\textasciicircum}2\}\{b{\textasciicircum}2\}I {\textbackslash}right){\textasciicircum}\{-1\} X{\textasciicircum}Ty{\textbackslash} {\textbackslash}end\{align\}] Now we see that the only difference between the weights estimated using MAp({\textbackslash}(w\_\{MAP\}{\textbackslash})) and using MLE ({\textbackslash}(w\_\{MLE\}{\textbackslash})) is the additional term {\textbackslash}({\textbackslash}frac\{{\textbackslash}sigma{\textasciicircum}2\}\{b{\textasciicircum}2\}I{\textbackslash}) in the inverse matrix, acting as a regularizer. Closed-form solution for Bayesian Linear Regression Instead of computing a point estimate via MLE or MAP, a special case of Bayesian optimization is the linear regression with normal priors and posterior. In this case, the posterior has an analytical solution. This approach is utilized very commonly, mainly since the result is not an estimation, and computing the analytical solution for the posteriors is extremelly fast to compute even for very large datasets and dimensionality. In brief, bayesian linear regression is a type of conditional modeling in which the mean of one variable is described by a linear combination of other variables, with the goal of obtaining the posterior probability of the regression coefficients (as well as other parameters describing the distribution of the regressand) and ultimately allowing the out-of-sample prediction of the regressand (often labelled \{{\textbackslash}displaystyle y\}y) conditional on observed values of the regressors (source: wikipedia page for Bayesian Linear Regression). I.e. Bayesian linear regression pushes the idea of the parameter prior a step further and does not even attempt to compute a point estimate of the parameters, but instead the full posterior distribution over the parameters is taken into account when making predictions. This means we do not fit any parameters, but we compute a mean over all plausible parameters settings (according to the posterior). We assume all our weights are drawn from a gaussian distribution and can be independent (if covariance matrix is diagonal) or not (otherwise). In practice, we start with the prior {\textbackslash}(p(w) {\textbackslash}thicksim {\textbackslash}mathcal\{N\}(m\_0, S\_0){\textbackslash}), with mean vector {\textbackslash}(m\_0{\textbackslash}), and (positive semi-definite) covariance matrix {\textbackslash}(S\_0{\textbackslash}) (following the variable notation found on Chris Bishop’s PRML book). We have then the following prior in multivariate notation: [p(w {\textbackslash}mid m\_0, S\_0 ) = (2 {\textbackslash}pi){\textasciicircum}\{-{\textbackslash}frac\{D\}\{2\}\} {\textbackslash},{\textbackslash}, det(S\_0){\textasciicircum}\{- {\textbackslash}frac\{1\}\{2\}\} {\textbackslash},{\textbackslash}, exp {\textbackslash}left( - {\textbackslash}frac\{1\}\{2\}(w - m\_0){\textasciicircum}T S\_0{\textasciicircum}\{-1\} (y-m\_0) {\textbackslash}right)] And the likelihood: [p(y {\textbackslash}mid X, w) = {\textbackslash}frac\{1\}\{(2 {\textbackslash}pi {\textbackslash}sigma{\textasciicircum}2){\textasciicircum}\{D/2\}\} exp {\textbackslash}left( -{\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} (y-Xw){\textasciicircum}T(y-Xw) {\textbackslash}right)] Going back to Equation {\textbackslash}ref\{posterior\_w\} and replacing the terms, we have: [{\textbackslash}begin\{align\} p(w {\textbackslash}mid X, y) \& = {\textbackslash}frac\{p(y{\textbackslash}mid X, w) p(w)\}\{p(y {\textbackslash}mid X )\} \& {\textbackslash}propto p(y{\textbackslash}mid X, w) p(w) \& {\textbackslash}text\{(dropped constant term in division)\} \& {\textbackslash}propto exp {\textbackslash}left( -{\textbackslash}frac\{1\}\{2 {\textbackslash}sigma{\textasciicircum}2\} (y-Xw){\textasciicircum}T(y-Xw) - {\textbackslash}frac\{1\}\{2\}(w-m\_0){\textasciicircum}TS\_0{\textasciicircum}\{-1\}(w-m\_0) {\textbackslash}right) \& {\textbackslash}text\{(dropped constant in multiplication)\} \& = exp {\textbackslash}left( -{\textbackslash}frac\{1\}\{2\} {\textbackslash}left( {\textbackslash}sigma{\textasciicircum}\{-2\} (y-Xw){\textasciicircum}T(y-Xw) + (w-m\_0){\textasciicircum}TS\_0{\textasciicircum}\{-1\}(w-m\_0) {\textbackslash}right) {\textbackslash}right) {\textbackslash}end\{align\}] We now apply the log-trick, and factorize the expression so that we can isolate quadratic, linear and independent terms on {\textbackslash}(w{\textbackslash}): [{\textbackslash}begin\{align\} \& log {\textbackslash},{\textbackslash}, p(w {\textbackslash}mid X, y) = \& -{\textbackslash}frac\{1\}\{2\} ({\textbackslash}sigma{\textasciicircum}\{-2\}(y-Xw){\textasciicircum}T(y-XW) + (w-m\_0){\textasciicircum}TS\_0{\textasciicircum}\{-1\}(w-m\_0)) + const \& {\textbackslash}text\{(ignore const due to zero-derivative)\} = \& - {\textbackslash}frac\{1\}\{2\} {\textbackslash}left( {\textbackslash}sigma{\textasciicircum}\{-2\} y{\textasciicircum}T y - 2{\textbackslash}sigma{\textasciicircum}\{-2\} y{\textasciicircum}T Xw + {\textbackslash}sigma{\textasciicircum}\{-2\} w{\textasciicircum}T X{\textasciicircum}T Xw + w{\textasciicircum}TS\_0{\textasciicircum}\{-1\}w - 2 m\_0{\textasciicircum}T S\_0{\textasciicircum}\{-1\} w + m\_0{\textasciicircum}T S\_0{\textasciicircum}\{-1\} m\_0 {\textbackslash}right) {\textbackslash}label\{eq1\_sq\} = \& - {\textbackslash}frac\{1\}\{2\} {\textbackslash}left( w{\textasciicircum}T ( {\textbackslash}sigma{\textasciicircum}\{-2\} X{\textasciicircum}TX + S\_0{\textasciicircum}\{-1\}) w {\textbackslash}right) \& {\textbackslash}hspace\{2cm\}{\textbackslash}text\{(terms quadratic in \} w {\textbackslash}text\{)\} {\textbackslash}label\{eq1\_lin\} \& + {\textbackslash}left( {\textbackslash}sigma{\textasciicircum}\{-2\} X{\textasciicircum}Ty + S\_0{\textasciicircum}\{-1\} m\_0){\textasciicircum}T w {\textbackslash}right) \& {\textbackslash}hspace\{2cm\}{\textbackslash}text\{(terms linear in \} w {\textbackslash}text\{)\} \& - {\textbackslash}frac\{1\}\{2\} {\textbackslash}left( {\textbackslash}sigma{\textasciicircum}\{-2\} y{\textasciicircum}T y + m\_0{\textasciicircum}T S\_0{\textasciicircum}\{-1\} m\_0 {\textbackslash}right) \& {\textbackslash}hspace\{2cm\}{\textbackslash}text\{(const terms independent of \} w {\textbackslash}text\{)\} {\textbackslash}end\{align\}] As a side note: looking at the last term, we can see that this function is quadratic in {\textbackslash}(w{\textbackslash}). Because the unnormalized log-posterior distribution is a negative (quadratic), implies that the posterior is Gaussian, i.e.: [{\textbackslash}begin\{align\} p(w{\textbackslash}mid X, y) = \& exp ( log {\textbackslash},{\textbackslash}, p(w{\textbackslash}mid y, X) ) ) {\textbackslash}propto \& exp ( log {\textbackslash},{\textbackslash}, p(y{\textbackslash}mid X, w) + log {\textbackslash},{\textbackslash}, p(w) ) \& {\textbackslash}text\{(Bayes equation)\} {\textbackslash}propto \& exp {\textbackslash}left( -{\textbackslash}frac\{1\}\{2\} w{\textasciicircum}T ( {\textbackslash}sigma{\textasciicircum}\{-2\} X{\textasciicircum}TX + S\_0{\textasciicircum}\{-1\}) w + {\textbackslash}left( {\textbackslash}sigma{\textasciicircum}\{-2\} X{\textasciicircum}Ty + S\_0{\textasciicircum}\{-1\} m\_0){\textasciicircum}T w {\textbackslash}right) {\textbackslash}right) \& {\textbackslash}text\{(quadratic and linear terms of \} log {\textbackslash},{\textbackslash}, p(w {\textbackslash}mid X, y) {\textbackslash}text\{)\} {\textbackslash}end\{align\}] where we used the linear and quadratic terms in {\textbackslash}(w{\textbackslash}) and ignored the {\textbackslash}(const{\textbackslash}) terms as their derivative is zero and do not change the proportional operation. Going back to the main problem, we now need to bring this unnormalized Gaussian into the form proportional to {\textbackslash}({\textbackslash}mathcal\{N\} ( w {\textbackslash}mid m\_N, S\_N ){\textbackslash}). We’ll utilize the method for completing the square to find the values that fit {\textbackslash}(m\_N{\textbackslash}) and {\textbackslash}(S\_N{\textbackslash}). We want the following log-posterior: [{\textbackslash}begin\{align\} {\textbackslash}mathcal\{N\} ( w {\textbackslash}mid m\_N, S\_N ) = \& -{\textbackslash}frac\{1\}\{2\}(w - {\textbackslash}mu){\textasciicircum}T S\_N{\textasciicircum}\{-1\}(w-{\textbackslash}mu) {\textbackslash} {\textbackslash}label\{eq2\_sq\} = \& -{\textbackslash}frac\{1\}\{2\} {\textbackslash}left(w{\textasciicircum}T S\_N{\textasciicircum}\{-1\}w {\textbackslash}right) \& {\textbackslash}hspace\{2cm\}{\textbackslash}text\{(terms quadratic in \} w {\textbackslash}text\{)\} {\textbackslash}label\{eq2\_lin\} \& + m{\textasciicircum}T\_N S{\textasciicircum}\{-1\}\_N w \& {\textbackslash}hspace\{2cm\}{\textbackslash}text\{(terms linear in \} w {\textbackslash}text\{)\} \& - {\textbackslash}frac\{1\}\{2\} {\textbackslash}left( m\_N{\textasciicircum}T S\_N{\textasciicircum}\{-1\} m\_N {\textbackslash}right) \& {\textbackslash}hspace\{2cm\}{\textbackslash}text\{(const terms independent of \} w {\textbackslash}text\{)\} {\textbackslash}end\{align\}] Thus, by matching the squared ({\textbackslash}ref\{eq1\_sq\}, {\textbackslash}ref\{eq2\_sq\}) and linear ({\textbackslash}ref\{eq1\_lin\}, {\textbackslash}ref\{eq2\_lin\}) expressions on the computed vs desired equations, we can find {\textbackslash}(S\_N{\textbackslash}) and {\textbackslash}(m\_N{\textbackslash}) as: [{\textbackslash}begin\{align\} \& w{\textasciicircum}T S\_N{\textasciicircum}\{-1\} w = {\textbackslash}sigma{\textasciicircum}\{-2\} w{\textasciicircum}TX{\textasciicircum}TXw+w{\textasciicircum}TS\_0{\textasciicircum}\{-1\} w {\textbackslash}Leftrightarrow \& w{\textasciicircum}T S\_N{\textasciicircum}\{-1\} w = w{\textasciicircum}T ( {\textbackslash}sigma{\textasciicircum}\{-2\} X{\textasciicircum}TX+ S{\textasciicircum}\{-1\}\_0) w {\textbackslash}Leftrightarrow \& S\_N{\textasciicircum}\{-1\} = {\textbackslash}sigma{\textasciicircum}\{-2\} X{\textasciicircum}T X + S{\textasciicircum}\{-1\}\_0 {\textbackslash}Leftrightarrow \& S\_N = ( {\textbackslash}sigma{\textasciicircum}\{-2\} X{\textasciicircum}TX + S{\textasciicircum}\{-1\}\_0){\textasciicircum}\{-1\} {\textbackslash}end\{align\}] and [{\textbackslash}begin\{align\} \& -2 m\_N{\textasciicircum}T S\_N{\textasciicircum}\{-1\}w = 2 ({\textbackslash}sigma{\textasciicircum}\{-2\}X{\textasciicircum}Ty + S\_0{\textasciicircum}\{-1\} m\_0){\textasciicircum}T w {\textbackslash}Leftrightarrow \& m\_N{\textasciicircum}T S\_N{\textasciicircum}\{-1\} = ({\textbackslash}sigma{\textasciicircum}\{-2\}X{\textasciicircum}Ty + S\_0{\textasciicircum}\{-1\} m\_0){\textasciicircum}T {\textbackslash}Leftrightarrow \& m\_N{\textasciicircum}T = S\_N ({\textbackslash}sigma{\textasciicircum}\{-2\}X{\textasciicircum}Ty + S\_0{\textasciicircum}\{-1\} m\_0) {\textbackslash}end\{align\}] inline with equations 3.50 and 3.51 in Chris Bishop’s PRML book. Online learning Online learning allows us to do iterative learning by continuously updating our posterior based on new observable data. The main principle is that — following the {\textbackslash}(posterior {\textbackslash}propto likelihood * prior{\textbackslash}) principle — at every iteration we turn our posterior into the new prior, i.e. the new initial knowledge is what we learnt previously. The main advantage is not requiring all the data at once for training and allowing us to learn from datasets that are not fully-available at once. An illustration of the principle is displayed below: illustration of four steps of online learning for the linear model {\textbackslash}(y = w\_0 + w\_1x{\textbackslash}). (inspired on fig 3.7, Pattern Classification and Machine Learning, Chris Bishop) We start with the prior knowledge that both weights ({\textbackslash}(w\_0{\textbackslash}) and {\textbackslash}(w\_1{\textbackslash})) are zero-centered, i.e. mean 0, and a std deviation of 1. When a new datapoint is introduced (blue circle on the top-right plot), the new posterior (top-left) is computed from the likelihood and our initial prior. Drawing models from the current priors leads to an innacurate regression model (yellow lines on the top-right plot) Another point is then introduced (2nd row, right), leading to a new posterior (second row, left), computed from the likelihood and the prior (i.e. the posterior of the previous iteration). The model is now more accurate and the earch space (covariance of the weights) is more reduced (second row, left). After two more iterations, the model is already very accurate with a reduce variance on the weights (bottom left) and better-tunned linear regression models (bottom right). Predictive Variance Remember that we wanted to model a noisy output defined by {\textbackslash}(y = Xw + {\textbackslash}varepsilon{\textbackslash}) with model parameters {\textbackslash}(w {\textbackslash}thicksim {\textbackslash}mathcal\{N\}({\textbackslash}mu, {\textbackslash}sigma{\textasciicircum}2){\textbackslash}) and noise parameter {\textbackslash}({\textbackslash}varepsilon {\textbackslash}thicksim {\textbackslash}mathcal\{N\}(0, {\textbackslash}sigma{\textasciicircum}2){\textbackslash}). The closed-form solution that computes the distribution of {\textbackslash}(w{\textbackslash}) was provided on the previous section. We’ll now compute the distribution of {\textbackslash}({\textbackslash}varepsilon{\textbackslash}). Note that drawing samples from the posterior {\textbackslash}(p(y {\textbackslash}mid X, w, {\textbackslash}sigma{\textasciicircum}2){\textbackslash}) is equivalent to drawing samples from {\textbackslash}(y = Xw + {\textbackslash}varepsilon{\textbackslash}). We can then compute the expectation of {\textbackslash}(y{\textbackslash}) as: [{\textbackslash}begin\{align\} {\textbackslash}mathbf\{E\} {\textbackslash}left[ y {\textbackslash}right] \& = {\textbackslash}mathbf\{E\} {\textbackslash}left[ X{\textasciicircum}Tw + {\textbackslash}varepsilon {\textbackslash}right] \& = X{\textasciicircum}T {\textbackslash}mathbf\{E\} {\textbackslash}left[ w {\textbackslash}right] + {\textbackslash}mathbf\{E\} {\textbackslash}left[ {\textbackslash}varepsilon {\textbackslash}right] \& = X{\textasciicircum}T m\_N {\textbackslash}end\{align\}] i.e. because noise has a mean zero, it’s a result equivalent to a linear regression where the weights are set to the close-form solution of their mean value. The variance of {\textbackslash}(y{\textbackslash}) follows analogously (see Variance rules at the end of the post if in doubt): [{\textbackslash}begin\{align\} {\textbackslash}mathbf\{Var\} {\textbackslash}left[ y {\textbackslash}right] \& = {\textbackslash}mathbf\{Var\} {\textbackslash}left[ Xw + {\textbackslash}varepsilon {\textbackslash}right] \& = {\textbackslash}mathbf\{Var\} {\textbackslash}left[ Xw {\textbackslash}right] + {\textbackslash}mathbf\{Var\} {\textbackslash}left[ {\textbackslash}varepsilon {\textbackslash}right] + 2{\textbackslash}mathbf\{Cov\} {\textbackslash}left[ X{\textasciicircum}Tw, {\textbackslash}varepsilon {\textbackslash}right] \& = {\textbackslash}mathbf\{Var\} {\textbackslash}left[ Xw {\textbackslash}right] + {\textbackslash}mathbf\{Var\} {\textbackslash}left[ {\textbackslash}varepsilon {\textbackslash}right] \& {\textbackslash}text\{(independent variables)\} \& = X{\textasciicircum}T {\textbackslash}mathbf\{Var\} {\textbackslash}left[ w {\textbackslash}right] X + {\textbackslash}mathbf\{Var\} {\textbackslash}left[ {\textbackslash}varepsilon {\textbackslash}right] \& {\textbackslash}text\{(Var linear transformation, rule 6))\} \& = X{\textasciicircum}T S\_N X + {\textbackslash}sigma{\textasciicircum}2 \& ( {\textbackslash}varepsilon {\textbackslash}thicksim {\textbackslash}mathcal\{N\}(0, {\textbackslash}sigma{\textasciicircum}2 ) {\textbackslash}text\{ and noise variance \} {\textbackslash}sigma{\textasciicircum}2 {\textbackslash}text\{)\} {\textbackslash}end\{align\}] Similarly to the visualization displayed before, introducing new datapoints improves the accuracy of our model: illustration of four steps modelling a synthetic sinusoidal data. Pictures with blue groudntruth, red model mean approximation, and light-orange area of predictive variance. (inspired on fig 3.8, Pattern Classification and Machine Learning, Chris Bishop) Comparing two Bayesian models If we want to compare two probabilistic models {\textbackslash}(M\_1,M\_2{\textbackslash}), with posteriors given the same dataset {\textbackslash}(D{\textbackslash}), we compute the ratio of the posteriors, a.k.a. the posterior odds as: [{\textbackslash}frac\{M\_1\}\{M\_2\} = {\textbackslash}frac\{ {\textbackslash}frac\{p(D {\textbackslash}mid M\_1) {\textbackslash}, p(M\_1)\}\{p(D)\} \}\{ {\textbackslash}frac\{p(D {\textbackslash}mid M\_2) {\textbackslash}, p(M\_2)\}\{p(D)\} \} = {\textbackslash}frac\{p(D {\textbackslash}mid M\_1) {\textbackslash}, p(M\_1)\}\{p(D {\textbackslash}mid M\_2) {\textbackslash}, p(M\_2)\}] If we assume the same prior for both models, then the equation simplifies to {\textbackslash}({\textbackslash}frac\{p(D {\textbackslash}mid M\_1)\}\{p(D {\textbackslash}mid M\_2)\}{\textbackslash}). If this ratio is greater than {\textbackslash}(1{\textbackslash}), we pick model {\textbackslash}(M\_1{\textbackslash}), otherwise we pick model {\textbackslash}(M\_2{\textbackslash}). Final Remarks For more advanced topics on Bayesian Linear Regression refer to chapter 3 in Pattern Recognition and Machine Learning book from Chris Bishop and chapter 9.3 in Mathematics for Machine Learning, both available on the resources page. To download the source code of the closed-form solutions and reproduce the examples above, download the Bayesian Linear Regression notebook. Finally, it has been shown that a kernelized Bayesian Linear Regression with the Kernel {\textbackslash}(K(x, x′)=x{\textasciicircum}Tx′{\textbackslash}) is equivalent to a Gaussian Process. Misc: linear models of the exponential family For a set up related to an output which is non-Gaussian but is a member of the exponential family, check Generalized Linear Models. Appendix: refresher on Linear Algebra Here are the list of algebraic rules used in this document. For further details, check The Matrix Cookbook for a more detailed list of matrix operations. Multiplication: {\textbackslash}(A(BC) = (AB)C{\textbackslash}); {\textbackslash}(A(B+C)=AB+AC{\textbackslash}); {\textbackslash}((B+C)A=BA+CA{\textbackslash}); {\textbackslash}(r(AB)=(rA)B=A(rB){\textbackslash}) for a scalar {\textbackslash}(r{\textbackslash}); {\textbackslash}(I\_mA=AI=AI\_n{\textbackslash}); {\textbackslash}((A+B){\textasciicircum}2 = (A+B)(A+B){\textasciicircum}T{\textbackslash}); {\textbackslash}((y - Xw){\textasciicircum}2 = (y-Xw){\textasciicircum}T(y-Xw){\textbackslash}). Transpose: {\textbackslash}((A{\textasciicircum}T){\textasciicircum}T = A{\textbackslash}); {\textbackslash}((A+B){\textasciicircum}T=A{\textasciicircum}T+B{\textasciicircum}T{\textbackslash}); {\textbackslash}((rA){\textasciicircum}T = rA{\textasciicircum}T{\textbackslash}) for a scalar {\textbackslash}(r{\textbackslash}); {\textbackslash}((AB){\textasciicircum}T=B{\textasciicircum}TA{\textasciicircum}T{\textbackslash}); Division: if {\textbackslash}(rA=B{\textbackslash}), then {\textbackslash}(r=BA{\textasciicircum}\{-1\}{\textbackslash}), for a scalar {\textbackslash}(r{\textbackslash}); if {\textbackslash}(Ar=B{\textbackslash}), then {\textbackslash}(r=A{\textasciicircum}\{-1\}B{\textbackslash}), for a scalar {\textbackslash}(r{\textbackslash}); {\textbackslash}(Ax=b{\textbackslash}) is the system of linear equations {\textbackslash}(a\_\{1,1\}x\_1 + a\_\{1,2\}x\_2 + ... + a\_\{1,n\}x\_n = b\_1{\textbackslash}) for row {\textbackslash}(1{\textbackslash}), repeated for every row; therefore, {\textbackslash}(x = A{\textasciicircum}\{-1\}b{\textbackslash}), if matrix has {\textbackslash}(A{\textbackslash}) an inverse; Inverse: {\textbackslash}(AA{\textasciicircum}\{-1\}=A{\textasciicircum}\{-1\}A=I{\textbackslash}); If {\textbackslash}(A{\textbackslash}) is invertible, its inverse is unique; If {\textbackslash}(A{\textbackslash}) is invertible, then {\textbackslash}(Ax=b{\textbackslash}) has an unique solution; If {\textbackslash}(A{\textbackslash}) is invertible, {\textbackslash}((A{\textasciicircum}\{-1\}){\textasciicircum}\{-1\}=A{\textbackslash}); {\textbackslash}(rA{\textasciicircum}\{-1\} = ({\textbackslash}frac\{1\}\{r\}A){\textasciicircum}\{-1\}{\textbackslash}) for a scalar {\textbackslash}(r{\textbackslash}); First Order derivatives: {\textbackslash}({\textbackslash}frac\{d w{\textasciicircum}TX\}\{dw\} = {\textbackslash}frac\{d X{\textasciicircum}Tw\}\{dw\} = X{\textbackslash}); {\textbackslash}({\textbackslash}frac\{d X{\textasciicircum}TwY\}\{dw\} = XY{\textasciicircum}T{\textbackslash}); {\textbackslash}({\textbackslash}frac\{d X{\textasciicircum}Tw{\textasciicircum}TY\}\{dw\} = YX{\textasciicircum}T{\textbackslash}); {\textbackslash}({\textbackslash}frac\{d X{\textasciicircum}TwX\}\{dw\} = {\textbackslash}frac\{d X{\textasciicircum}Tw{\textasciicircum}TX\}\{dw\} = XX{\textasciicircum}T{\textbackslash}); Variance and Covariance: {\textbackslash}({\textbackslash}mathbb\{Var\}(X) = {\textbackslash}mathbb\{Cov\}(X,X){\textbackslash}); {\textbackslash}({\textbackslash}mathbb\{Var\}(rX) = r {\textbackslash}mathbb\{Var\}(X){\textbackslash}), for scalar {\textbackslash}(r{\textbackslash}); {\textbackslash}({\textbackslash}mathbb\{Var\}(X+Y) = {\textbackslash}mathbb\{Var\}(X) + {\textbackslash}mathbb\{Var\}(Y) + 2{\textbackslash}mathbb\{Cov\}(X,Y){\textbackslash}); {\textbackslash}({\textbackslash}mathbb\{Var\}(X+Y) = {\textbackslash}mathbb\{Var\}(X) + {\textbackslash}mathbb\{Var\}(Y){\textbackslash}), if X and Y are independent (ie, zero covariance); {\textbackslash}({\textbackslash}mathbb\{Var\}(X) = {\textbackslash}mathbf\{E\}[(X-{\textbackslash}mathbf\{E\}[X]){\textasciicircum}2 ] = {\textbackslash}mathbf\{E\} {\textbackslash}left[ X{\textasciicircum}2 - 2X{\textbackslash}mathbf\{E\}[X] + {\textbackslash}mathbf\{E\}[X]{\textasciicircum}2 {\textbackslash}right] = {\textbackslash}mathbf\{E\}[X{\textasciicircum}2] - 2{\textbackslash}mathbf\{E\}[X]{\textbackslash}mathbf\{E\}[X] + {\textbackslash}mathbf\{E\}[X]{\textasciicircum}2 = {\textbackslash}mathbf\{E\}[X{\textasciicircum}2] - {\textbackslash}mathbf\{E\}[X]{\textasciicircum}2{\textbackslash}); If {\textbackslash}(y{\textbackslash}) is a linear transformation of univariate form {\textbackslash}(y=mx+b{\textbackslash}) or multivariate form {\textbackslash}(y=Xw+b{\textbackslash}) then: Variance in univariate form: {\textbackslash}({\textbackslash}mathbb\{Var\}(y)=m{\textasciicircum}2 {\textbackslash},{\textbackslash}, {\textbackslash}mathbb\{Var\}(w){\textbackslash}); Variance in multivariate form: {\textbackslash}(Var (Xw + b) = Var (Xw) = X {\textbackslash}mathbb\{Var\}(w) X{\textasciicircum}T = X {\textbackslash}Sigma X{\textasciicircum}T{\textbackslash}), where {\textbackslash}({\textbackslash}Sigma{\textbackslash}) is the covariance matrix of {\textbackslash}(X{\textbackslash}); Expected Value in multivariate form: {\textbackslash}({\textbackslash}mathbf\{E\}[Xw + b] = X {\textbackslash}mathbf\{E\}[w] + b = X {\textbackslash}mu + b{\textbackslash}), where {\textbackslash}({\textbackslash}mu{\textbackslash}) is the mean of {\textbackslash}(X{\textbackslash}) formulas 6.50 and 6.51 in Mathematics for Machine Learning},

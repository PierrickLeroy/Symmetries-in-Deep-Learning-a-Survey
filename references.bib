	url = {http://ieeexplore.ieee.org/document/7025987/},
	doi = {10.1109/ICIP.2014.7025987},
	abstract = {We develop topologically accurate and compatible deﬁnitions for the skeleton and watershed segmentation of a 3D digital object that are computed by a single algorithm. These definitions are based on a discrete gradient vector ﬁeld derived from a signed distance transform. This gradient vector ﬁeld is amenable to topological analysis and simpliﬁcation via Forman’s discrete Morse theory and provides a ﬁltration that can be used as input to persistent homology algorithms. Efﬁcient implementations allow us to process large-scale x-ray microCT data of rock cores and other materials.},
	language = {en},
